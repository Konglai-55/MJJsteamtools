<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="MJJsteamtools"
      Manufacturer="DreamPixel studio"
      Version="$(var.Version)"
      Language="2052"
      UpgradeCode="3FBFA997-44EF-4E91-9DCA-BECEFBF5D665"
      Scope="perUser"
      InstallerVersion="500">

    <MajorUpgrade
        DowngradeErrorMessage="已安装更高版本的 MJJsteamtools。"
        Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.ProjectDir)\Assets\brand-app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="MJJsteamtools" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MJJsteamtools" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Component Id="MainProgram" Directory="INSTALLFOLDER" Guid="D8393472-C1A8-44DE-82DA-C96F3BFB27A7">
      <File Id="MainExecutable"
            Source="$(var.PublishDir)\MJJsteamtools.exe"
            Name="MJJsteamtools.exe" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\DreamPixel studio\MJJsteamtools\Components"
                     Name="MainProgram"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="MJJsteamtools"
                Description="Steam Lua/Bin 游戏入库管理工具"
                Target="[INSTALLFOLDER]MJJsteamtools.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="MJJsteamtools"
                Description="Steam Lua/Bin 游戏入库管理工具"
                Target="[INSTALLFOLDER]MJJsteamtools.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\DreamPixel studio\MJJsteamtools"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Feature Id="Complete" Title="MJJsteamtools" Level="1">
      <ComponentRef Id="MainProgram" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>
  </Package>
</Wix>
