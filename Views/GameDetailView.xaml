<UserControl x:Class="SteamLuaManager.Views.GameDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="{DynamicResource SteamContentBrush}"
        Focusable="True"
        PreviewKeyDown="GameDetailView_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="DetailToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="60" Height="30">
                            <Border x:Name="Track" CornerRadius="15" Background="#111B27"/>
                            <Ellipse x:Name="Thumb" Width="24" Height="24"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" Fill="#AAAAAA"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SteamAccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#152333"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#26465D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteamSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,15"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Effect" Value="{StaticResource SteamSectionShadowEffect}"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextTertiaryBrush}"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="SaveMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="Text" Value="—">
                    <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
                </Trigger>
                <Trigger Property="Text" Value="暂无存档">
                    <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveMetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteamShellBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="DetailNavTabStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="17,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="46" Background="Transparent">
                            <Border x:Name="HoverSurface" Margin="2,3,2,7" CornerRadius="6"
                                    Background="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="ActiveLine" Height="3" Margin="16,0,16,0"
                                    VerticalAlignment="Bottom" CornerRadius="2,2,0,0"
                                    Background="{DynamicResource SteamAccentBrush}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="#23384B"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="{DynamicResource SteamAccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="HoverSurface" Property="Background" Value="#1B3448"/>
                                <Setter TargetName="ActiveLine" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HoverSurface" Property="Background" Value="#2A465B"/>
                                <Setter TargetName="ActiveLine" Property="Opacity" Value="1"/>
                                <Setter TargetName="ActiveLine" Property="Height" Value="4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SteamSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource SteamSectionShadowEffect}"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextTertiaryBrush}"/>
        </Style>

        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SteamSecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#FF8B86"/>
            <Setter Property="BorderBrush" Value="#7E3D3A"/>
        </Style>

        <Style x:Key="AchievementActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SteamSecondaryButtonStyle}">
            <Setter Property="Content" Value="解锁"/>
            <Setter Property="Foreground" Value="#66C5FF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="62"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter Property="Content" Value="重锁"/>
                    <Setter Property="Foreground" Value="#C4CBD3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Content" Value="处理中…"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanManage}" Value="False">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AchievementListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="controls:MotionBehavior.IsEntranceEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DetailHeaderPanel" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Width="38" Height="38" Padding="0" Margin="0,0,14,0"
                    Style="{StaticResource SteamSecondaryButtonStyle}"
                    Click="BackButton_Click" ToolTip="返回游戏库"
                    AutomationProperties.Name="返回游戏库">
                <ui:FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="游戏库  /  游戏详情" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SteamAccentBrush}"/>
                <TextBlock Text="游戏详情" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"
                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SteamSecondaryButtonStyle}" Padding="12,7"
                        Margin="0,0,8,0" Click="OpenLibraryButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE7FC;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Steam 库"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SteamPrimaryButtonStyle}" Padding="14,7"
                        Click="LaunchGameButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE768;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="启动游戏"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- A quiet, persistent section rail; selection is conveyed by text and underline. -->
        <Border x:Name="DetailNavigationBar" Grid.Row="1" Background="Transparent" BorderBrush="#344657"
                BorderThickness="0,0,0,1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OverviewTabButton" Style="{StaticResource DetailNavTabStyle}"
                        AutomationProperties.Name="概览" Click="OverviewTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE80F;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="概览" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveTabButton" Style="{StaticResource DetailNavTabStyle}"
                        AutomationProperties.Name="存档保护" Click="SaveTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE753;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="存档保护" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DlcTabButton" Style="{StaticResource DetailNavTabStyle}"
                        AutomationProperties.Name="DLC 管理" Click="DlcTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE8F1;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="DLC 管理" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AchievementTabButton" Style="{StaticResource DetailNavTabStyle}"
                        Margin="0" AutomationProperties.Name="成就" Click="AchievementTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE735;" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="成就" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="DetailScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>

                <Border x:Name="OverviewSection" Background="{DynamicResource SteamSurfaceBrush}"
                        CornerRadius="10" Effect="{StaticResource SteamSectionShadowEffect}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <controls:ClippingBorder Height="212" CornerRadius="10,0,0,10"
                                                 Background="{DynamicResource SteamShellBrush}">
                            <Grid>
                                <Image x:Name="DetailCoverImage" Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </controls:ClippingBorder>

                        <Grid x:Name="DetailHeroInfoPanel" Grid.Column="1" Margin="22,20,22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="游戏概览" FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SteamAccentBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Width="32" Height="32" Padding="0" Margin="0,0,5,0"
                                                Style="{StaticResource SteamSecondaryButtonStyle}"
                                                Click="OpenStoreButton_Click" ToolTip="Steam 商店"
                                                AutomationProperties.Name="打开 Steam 商店">
                                            <ui:FontIcon Glyph="&#xE774;" FontSize="14"/>
                                        </Button>
                                        <Button Width="32" Height="32" Padding="0" Margin="0,0,5,0"
                                                Style="{StaticResource SteamSecondaryButtonStyle}"
                                                Click="QueryDlcButton_Click" ToolTip="查询 DLC"
                                                AutomationProperties.Name="查询 DLC">
                                            <ui:FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                                        </Button>
                                        <Button Width="32" Height="32" Padding="0" Margin="0,0,5,0"
                                                Style="{StaticResource SteamSecondaryButtonStyle}"
                                                Click="RefreshButton_Click" ToolTip="刷新游戏信息"
                                                AutomationProperties.Name="刷新游戏信息">
                                            <ui:FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        </Button>
                                        <Button x:Name="HeroMoreActionsButton" Width="32" Height="32" Padding="0"
                                                Style="{StaticResource SteamSecondaryButtonStyle}"
                                                Click="HeroMoreActions_Click" ToolTip="更多游戏操作"
                                                AutomationProperties.Name="更多游戏操作">
                                            <ui:FontIcon Glyph="&#xE712;" FontSize="15"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Background="#162432" BorderBrush="#31485B"
                                                             Foreground="{DynamicResource SteamTextPrimaryBrush}" Padding="5">
                                                    <MenuItem Header="固定到最新版本" Click="PinLatestButton_Click"/>
                                                    <MenuItem Header="固定到当前安装版本" Click="PinCurrentButton_Click"/>
                                                    <MenuItem Header="取消版本固定" Click="UnpinButton_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="存档与云同步设置" Click="ShowSaveSettings_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="删除 Lua" Click="DeleteLuaButton_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding GameName}" FontSize="27" FontWeight="SemiBold"
                                           Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="74"
                                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                <TextBlock Text="{Binding AppId, StringFormat=AppID: {0}}" FontSize="12"
                                           Margin="0,7,0,0" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                <WrapPanel Margin="0,16,0,0">
                                    <Border x:Name="ImportStatusBadge" CornerRadius="5" Padding="9,5" Margin="0,0,8,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#193B55"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Background" Value="#30343A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="已启用入库"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SteamAccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Text" Value="已禁止入库"/>
                                                            <Setter Property="Foreground" Value="#B7BBC0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#263B49" CornerRadius="5" Padding="9,5" Margin="0,0,0,5">
                                        <TextBlock x:Name="HeroInstallStatusText" Text="正在检查本地安装…"
                                                   FontSize="11" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="加入游戏库" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                    <TextBlock Text="关闭后暂时停用这款游戏的入库配置" FontSize="11" Margin="0,3,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                </StackPanel>
                                <ToggleButton x:Name="DetailImportToggle" Grid.Column="1"
                                              Style="{StaticResource DetailToggleStyle}"
                                              IsChecked="{Binding IsDisabled, Converter={StaticResource BoolInvertConverter}, Mode=OneWay}"
                                              Click="ImportToggle_Click"
                                              ToolTip="开启：已入库；关闭：禁止入库"/>
                            </Grid>
                        </Grid>

                    </Grid>
                </Border>

                <UniformGrid x:Name="DetailMetricStrip" Columns="4" Margin="0,12,0,0">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:FontIcon Glyph="&#xE8A5;" FontSize="17" Foreground="{DynamicResource SteamAccentBrush}"
                                             DockPanel.Dock="Right"/>
                                <TextBlock Text="DEPOT 清单" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="DepotCountText" Text="0 个" Style="{StaticResource MetricValueStyle}"/>
                            <Border Background="{DynamicResource SteamAccentBrush}" Height="3" CornerRadius="2"
                                    Width="30" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:FontIcon Glyph="&#xE8F1;" FontSize="17" Foreground="{DynamicResource SteamGreenBrush}"
                                             DockPanel.Dock="Right"/>
                                <TextBlock Text="DLC 入库" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,5,0,0">
                                <TextBlock x:Name="DlcSummaryText" Text="正在获取…" Style="{StaticResource MetricValueStyle}" Margin="0"/>
                                <ui:ProgressRing x:Name="DlcLoadingRing" Width="16" Height="16" IsActive="True"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Background="{DynamicResource SteamGreenBrush}" Height="3" CornerRadius="2"
                                    Width="30" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:FontIcon Glyph="&#xE787;" FontSize="17" Foreground="#E4BA77"
                                             DockPanel.Dock="Right"/>
                                <TextBlock Text="版本状态" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="ManifestPinStatusText" Text="未固定" Style="{StaticResource MetricValueStyle}"/>
                            <Border Background="#E4BA77" Height="3" CornerRadius="2"
                                    Width="30" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}" Margin="0">
                        <StackPanel>
                            <DockPanel>
                                <ui:FontIcon Glyph="&#xE8D7;" FontSize="17" Foreground="#B5A8E2"
                                             DockPanel.Dock="Right"/>
                                <TextBlock Text="APP TOKEN" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="TokenStatusText" Text="未写入" Style="{StaticResource MetricValueStyle}"/>
                            <Border Background="#B5A8E2" Height="3" CornerRadius="2"
                                    Width="30" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE8B7;" FontSize="17" Margin="0,0,9,0"
                                             Foreground="{DynamicResource SteamAccentBrush}"/>
                                <TextBlock Text="本地安装" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="检查是否已下载，并快速定位游戏文件。" FontSize="11" Margin="0,5,0,4"
                                       Foreground="{DynamicResource SteamTextTertiaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="安装状态" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="InstallStatusText" Text="正在检查…" Style="{StaticResource FieldValueStyle}"/>
                            <TextBlock Text="游戏目录" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="InstallPathText" Text="未检测到" Style="{StaticResource FieldValueStyle}"/>
                            <Button x:Name="OpenInstallFolderButton" Content="打开游戏目录"
                                    Style="{StaticResource SteamSecondaryButtonStyle}"
                                    Padding="11,6" Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Click="OpenInstallFolderButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE943;" FontSize="17" Margin="0,0,9,0"
                                             Foreground="{DynamicResource SteamGreenBrush}"/>
                                <TextBlock Text="Lua 清单" Style="{StaticResource SectionTitleStyle}"/>
                            </StackPanel>
                            <TextBlock Text="查看入库配置的实际文件与更新时间。" FontSize="11" Margin="0,5,0,4"
                                       Foreground="{DynamicResource SteamTextTertiaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="文件位置" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="LuaPathText" Text="未找到" Style="{StaticResource FieldValueStyle}"/>
                            <TextBlock Text="文件信息" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="LuaFileInfoText" Text="—" Style="{StaticResource FieldValueStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="在目录中显示" Style="{StaticResource SteamSecondaryButtonStyle}"
                                        Padding="11,6" Margin="0,0,8,0" Click="RevealLuaButton_Click"/>
                                <Button Content="编辑 Lua" Style="{StaticResource SteamSecondaryButtonStyle}"
                                        Padding="11,6" Click="EditLuaButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="SaveManagementSection" Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE753;" FontSize="17" Margin="0,0,9,0"
                                                 Foreground="{DynamicResource SteamGreenBrush}"/>
                                    <TextBlock Text="存档" Style="{StaticResource SectionTitleStyle}"/>
                                    <Border x:Name="SaveModeBadge" Background="#26323E" CornerRadius="4"
