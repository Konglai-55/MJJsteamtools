                                                    <ui:FontIcon Glyph="&#xE756;" FontSize="11" Width="16"
                                                                 Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                                    <TextBlock Text="{Binding LaunchSummary}" FontSize="11" Margin="6,0,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <WrapPanel Grid.Row="2">
                                                    <Button Content="应用" ToolTip="只应用方案，不启动游戏" Tag="{Binding}" Padding="10,6" Margin="0,0,6,0"
                                                            Style="{StaticResource SteamSecondaryButtonStyle}"
                                                            Click="ApplyPlayProfile_Click"/>
                                                    <Button Content="应用并启动" Tag="{Binding}" Padding="11,6"
                                                            Style="{StaticResource SteamPrimaryButtonStyle}"
                                                            Click="ApplyAndLaunchPlayProfile_Click"/>
                                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0"
                                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Button Width="30" Height="30" Padding="0" Margin="0,0,4,0" Tag="{Binding}"
                                                            ToolTip="编辑方案" Style="{StaticResource SteamSecondaryButtonStyle}"
                                                            Click="EditPlayProfile_Click">
                                                        <ui:FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                                    </Button>
                                                    <Button Width="30" Height="30" Padding="0" Tag="{Binding}"
                                                            ToolTip="删除方案" Style="{StaticResource DangerButtonStyle}"
                                                            Click="DeletePlayProfile_Click">
                                                        <ui:FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                    </Grid>
                </Border>

                <Border x:Name="AchievementSection" Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE735;" FontSize="17" Margin="0,0,9,0"
                                                 Foreground="#E4BA77"/>
                                    <TextBlock Text="成就" Style="{StaticResource SectionTitleStyle}"/>
                                    <Border x:Name="AchievementModeBadge" Background="#26323E" CornerRadius="4"
                                            Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AchievementModeText" Text="正在读取" FontSize="10"
                                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="AchievementStatusText"
                                           Text="正在读取本地成就缓存与 Steam 账号状态…"
                                           FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            </StackPanel>
                            <Button x:Name="RefreshAchievementsButton" Grid.Column="1"
                                    Style="{StaticResource SteamSecondaryButtonStyle}"
                                    Padding="11,6" Click="RefreshAchievementsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE72C;" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="刷新成就"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AchievementCountText" Text="0 / 0 已解锁" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                <ProgressBar x:Name="AchievementProgressBar" Height="4" Margin="0,8,0,0"
                                             Minimum="0" Maximum="1" Value="0"/>
                            </StackPanel>

                            <StackPanel x:Name="AchievementAdvancedFilterBar" Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Visibility="Collapsed">
                                <controls:SearchTextBox x:Name="AchievementSearchBox" Width="210" Height="34"
                                                        Style="{StaticResource SteamSearchTextBoxStyle}"
                                                        ToolTip="搜索成就名称、说明或 API 名称"
                                                        AutomationProperties.Name="搜索成就名称、说明或 API 名称"
                                                        TextChanged="AchievementSearchBox_TextChanged"/>
                                <ComboBox x:Name="AchievementFilterCombo" Width="112" Height="34" Margin="8,0,12,0"
                                          SelectedIndex="0" SelectionChanged="AchievementFilterCombo_SelectionChanged">
                                    <ComboBoxItem Content="全部成就"/>
                                    <ComboBoxItem Content="未解锁"/>
                                    <ComboBoxItem Content="已解锁"/>
                                    <ComboBoxItem Content="隐藏成就"/>
                                </ComboBox>
                            </StackPanel>

                            <ui:ProgressRing x:Name="AchievementLoadingRing" Grid.Column="2"
                                             Width="22" Height="22" IsActive="True"
                                             VerticalAlignment="Center"/>
                        </Grid>

                        <Border x:Name="AchievementResultBar" Background="#111C27" CornerRadius="6"
                                Padding="11,8" Margin="0,12,0,0" Visibility="Collapsed"
                                controls:MotionBehavior.IsRevealEnabled="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon x:Name="AchievementResultIcon" Glyph="&#xE73E;" FontSize="13"
                                             Foreground="{DynamicResource SteamGreenBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="AchievementResultText" FontSize="12"
                                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SteamShellBrush}" CornerRadius="7" Margin="0,14,0,0" Padding="13">
                            <StackPanel>
                                <Grid x:Name="AchievementFeaturedPanel" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="5" Background="#0C141D">
                                        <Grid>
                                            <ui:FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ActiveIconUrl}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="已解锁的成就" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                    <ItemsControl x:Name="AchievementUnlockedPreviewItems" Grid.Column="1">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="46" Height="46" CornerRadius="4" Margin="0,0,7,0"
                                                        Background="#0C141D" BorderBrush="#345344" BorderThickness="1">
                                                    <Grid>
                                                        <ui:FontIcon Glyph="&#xE735;" FontSize="18" Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding ActiveIconUrl}" Stretch="UniformToFill"
                                                               ToolTip="{Binding Name}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="AchievementUnlockedRemainingBadge" Grid.Column="2"
                                            MinWidth="48" Height="46" Background="#1B2633" CornerRadius="4">
                                        <TextBlock x:Name="AchievementUnlockedRemainingText" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="#263442" Margin="0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="锁定的成就" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                    <ItemsControl x:Name="AchievementLockedPreviewItems" Grid.Column="1" Opacity="0.62">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="46" Height="46" CornerRadius="4" Margin="0,0,7,0"
                                                        Background="#0C141D" BorderBrush="#34404D" BorderThickness="1">
                                                    <Grid>
                                                        <ui:FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding ActiveIconUrl}" Stretch="UniformToFill"
                                                               ToolTip="{Binding Name}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="AchievementLockedRemainingBadge" Grid.Column="2"
                                            MinWidth="48" Height="46" Background="#1B2633" CornerRadius="4">
                                        <TextBlock x:Name="AchievementLockedRemainingText" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="ToggleAchievementManagementButton" Content="查看全部成就"
                                Style="{StaticResource SteamSecondaryButtonStyle}" HorizontalAlignment="Right"
                                Padding="12,7" Margin="0,12,0,0" Click="ToggleAchievementManagement_Click"/>

                        <WrapPanel x:Name="AchievementBatchActions" Margin="0,12,0,4" IsEnabled="False"
                                   Visibility="Collapsed">
                            <Button Content="解锁选中" Style="{StaticResource SteamPrimaryButtonStyle}"
                                    Padding="12,7" Margin="0,0,8,8" Click="UnlockSelectedAchievements_Click"/>
                            <Button Content="重锁选中" Style="{StaticResource SteamSecondaryButtonStyle}"
                                    Padding="12,7" Margin="0,0,8,8" Click="LockSelectedAchievements_Click"/>
                            <Button Content="全部解锁" Style="{StaticResource SteamSecondaryButtonStyle}"
                                    Padding="12,7" Margin="0,0,8,8" Click="UnlockAllAchievements_Click"/>
                            <Button Content="全部重锁" Style="{StaticResource DangerButtonStyle}"
                                    Padding="12,7" Margin="0,0,8,8" Click="LockAllAchievements_Click"/>
                            <Button Content="打开自动备份" Style="{StaticResource SteamSecondaryButtonStyle}"
                                    Padding="12,7" Margin="0,0,8,8" Click="OpenAchievementBackups_Click"/>
                        </WrapPanel>

                        <Border x:Name="AchievementAdvancedListContainer" Background="{DynamicResource SteamShellBrush}" CornerRadius="7"
                                Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid>
                                <ListBox x:Name="AchievementList" Height="430" Background="Transparent"
                                         BorderThickness="0" Padding="7" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource AchievementListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#162330"/>
                                                        <Setter Property="BorderBrush" Value="#263746"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                <Setter Property="Background" Value="#172A29"/>
                                                                <Setter Property="BorderBrush" Value="#285348"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanManage}"
                                                              VerticalAlignment="Center" Margin="2,0,10,0"/>
                                                    <Border Grid.Column="1" Width="46" Height="46" CornerRadius="5"
                                                            Background="#0E1721" VerticalAlignment="Center">
                                                        <Grid>
                                                            <ui:FontIcon Glyph="&#xE735;" FontSize="20"
                                                                         Foreground="#566575"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding ActiveIconUrl}" Stretch="UniformToFill"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Margin="10,0,16,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border Background="#493B2A" CornerRadius="3" Padding="5,2" Margin="7,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="隐藏" FontSize="9" Foreground="#EBC78A"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding ApiName}" FontFamily="Consolas" FontSize="9"
                                                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                                            <TextBlock Text="{Binding UnlockTimeText}" FontSize="10" Margin="10,0,0,0"
                                                                       Foreground="#72A88D"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StateText}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,5">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#8895A3"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SteamGreenBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Button Style="{StaticResource AchievementActionButtonStyle}"
                                                                Tag="{Binding}" Click="AchievementActionButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="EmptyAchievementsPanel" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon Glyph="&#xE735;" FontSize="28" Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                                 HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂时没有可显示的成就" FontSize="12" Margin="0,10,0,0"
                                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE8A5;" FontSize="17" Margin="0,0,9,0"
                                         Foreground="{DynamicResource SteamAccentBrush}"/>
                            <TextBlock Text="Depot 清单" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <TextBlock Text="仅展示密钥是否存在，不显示密钥原文"
                                   FontSize="11" Margin="0,3,0,12"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        <Border Background="{DynamicResource SteamShellBrush}" CornerRadius="5" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Depot ID" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Manifest" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="密钥" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="固定" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="DepotItemsControl" Margin="0,3,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SteamDividerBrush}" BorderThickness="0,0,0,1"
                                            Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DepotId}" FontSize="12"
                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Manifest}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding KeyStatus}" FontSize="12"
                                                       Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PinStatus}" FontSize="12"
                                                       Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyDepotsText" Text="当前 Lua 中没有 Depot 清单"
                                   FontSize="12" Margin="12,13,0,4"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
