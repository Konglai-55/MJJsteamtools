<UserControl x:Class="SteamLuaManager.Views.ScriptDownloadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="RecommendationBadgeBrush" Color="#1D4057"/>

        <Style x:Key="RecommendationImportButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SteamPrimaryButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ImportButtonBody" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ImportButtonBody" Property="Background" Value="{StaticResource SteamPrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ImportButtonBody" Property="Background" Value="{StaticResource SteamPrimaryButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CarouselArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowHover" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowHover" Property="Background" Value="#243E56"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FeaturedLargeCardTemplate">
            <Grid Background="Transparent" Style="{StaticResource SteamHoverLiftStyle}">
                <Border Margin="0,12,0,0" Background="#0C1520" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding PortraitCoverUrl}" Tag="{Binding}"
                               ImageFailed="PortraitRecommendationImage_ImageFailed"
                               DataContextChanged="RecommendationImage_DataContextChanged" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Command="{Binding DataContext.DownloadGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource RecommendationImportButtonStyle}"
                                IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}">
                            一键入库
                        </Button>
                    </Grid>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0" Padding="10,5"
                        Background="{StaticResource RecommendationBadgeBrush}" CornerRadius="0,0,5,0">
                    <TextBlock Text="热门推荐" Foreground="White" FontSize="11"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FeaturedSmallCardTemplate">
            <Grid Background="Transparent" Style="{StaticResource SteamHoverLiftStyle}">
                <Border Margin="0,12,0,0" Background="#0C1520" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding CoverUrl}" Tag="{Binding}"
                               ImageFailed="WideRecommendationImage_ImageFailed"
                               DataContextChanged="RecommendationImage_DataContextChanged" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Command="{Binding DataContext.DownloadGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource RecommendationImportButtonStyle}"
                                IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}">
                            一键入库
                        </Button>
                    </Grid>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0" Padding="10,5"
                        Background="{StaticResource RecommendationBadgeBrush}" CornerRadius="0,0,5,0">
                    <TextBlock Text="热门推荐" Foreground="White" FontSize="11"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FeaturedPeekCardTemplate">
            <Grid Background="Transparent" Style="{StaticResource SteamHoverLiftStyle}">
                <Border Margin="0,12,0,0" Background="#0C1520" ClipToBounds="True">
                    <Image Source="{Binding PortraitCoverUrl}" Tag="{Binding}"
                           ImageFailed="PortraitRecommendationImage_ImageFailed"
                           DataContextChanged="RecommendationImage_DataContextChanged" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="0" Padding="10,5"
                        Background="{StaticResource RecommendationBadgeBrush}" CornerRadius="0,0,5,0">
                    <TextBlock Text="热门推荐" Foreground="White" FontSize="11"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GameResultRowTemplate">
            <Border Background="{DynamicResource SteamSurfaceBrush}" BorderThickness="0"
                    Style="{StaticResource SteamHoverLiftStyle}"
                    Padding="0" MinHeight="90" Margin="0,0,0,8"
                    CornerRadius="3" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="{Binding CoverUrl}" Tag="{Binding}"
                           ImageFailed="WideRecommendationImage_ImageFailed"
                           DataContextChanged="RecommendationImage_DataContextChanged" Width="210" Height="90"
                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,8,12,8">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SecondaryName}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSecondaryName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding AppId, StringFormat=AppID {0}}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                MinWidth="112" Margin="8,6,0,6">
                        <TextBlock Text="{Binding Price}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamGreenBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ReleaseDate}" FontSize="11" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Grid.Column="3" Tag="{Binding}" Click="OpenSteamStoreButton_Click"
                            Width="44" Height="42" Padding="0" Focusable="False" Margin="14,0,8,0"
                            VerticalAlignment="Center" Background="#4B681A" BorderBrush="#4B681A"
                            ToolTip="在 Steam 客户端中打开商店页"
                            AutomationProperties.Name="在 Steam 客户端中打开商店页">
                        <ui:FontIcon Glyph="&#xE719;" FontSize="20" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                    </Button>
                    <Button Grid.Column="4"
                            Command="{Binding DataContext.DownloadGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SteamPrimaryButtonStyle}"
                            Width="86" Height="42" Padding="10,6" FontSize="15"
                            Focusable="False" Margin="0,0,14,0" VerticalAlignment="Center"
                            IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}">
                        入库
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,28" HorizontalAlignment="Stretch">

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="搜索并入库" Style="{StaticResource SteamPageTitleStyle}"/>
                    <TextBlock Text="按中文名、英文名、别名或 Steam AppID 查找；确认后写入本地游戏库"
                               Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#182E3E" BorderBrush="#31526A"
                        BorderThickness="1" CornerRadius="3" Padding="11,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="清单源  " Foreground="{DynamicResource SteamTextTertiaryBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding CurrentDataSourceLabel, Mode=OneWay}"
                                   Foreground="{DynamicResource SteamAccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 紧凑搜索区 -->
            <Grid Width="570" HorizontalAlignment="Left" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="40" Style="{StaticResource SteamSearchFieldBorderStyle}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False" Foreground="#929AA3"/>
                <ui:AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                   Style="{StaticResource SteamSearchSuggestStyle}"
                                   ToolTip="搜索游戏名称或 AppID"
                                   AutomationProperties.Name="搜索游戏名称或 AppID"
                                   Height="40" HorizontalAlignment="Stretch"
                                   ItemsSource="{Binding SearchSuggestions}"
                                   TextMemberPath="Name" UpdateTextOnSelect="True"
                                   MaxSuggestionListHeight="360"
                                   QuerySubmitted="SearchBox_QuerySubmitted"
                                   SuggestionChosen="SearchBox_SuggestionChosen"
                                   TextChanged="SearchBox_TextChanged">
                    <ui:AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinWidth="380" Margin="4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SecondaryName}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSecondaryName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AppId, StringFormat=AppID {0}}"
                                           Margin="18,0,2,0" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ui:AutoSuggestBox.ItemTemplate>
                </ui:AutoSuggestBox>
                </Grid>
                </Border>
                <Button Grid.Column="1" Command="{Binding SearchCommand}"
                        Style="{StaticResource SteamPrimaryButtonStyle}"
                        Height="40" MinWidth="92" Margin="8,0,0,0"
                        IsEnabled="{Binding IsSearching, Converter={StaticResource BoolInvertConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE721;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="搜索" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{Binding RefreshKeyCacheCommand}"
                        Style="{StaticResource SteamSecondaryButtonStyle}"
                        Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                        Visibility="{Binding IsLocalCacheMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="更新密钥缓存">
                    <ui:FontIcon Glyph="&#xE72C;" FontSize="15"/>
                </Button>
            </Grid>

            <!-- 首屏推荐：执行搜索或入库后让位给日志和结果。 -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStartedSearch}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="热门推荐" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,48,2">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SteamGreenBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="Steam 在线热门 · 每日更新 · 已排除免费游戏" FontSize="12"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid Height="360" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1" Background="#223E59" CornerRadius="0" ClipToBounds="True">
                        <Grid Margin="14,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0" Content="{Binding HotRecommendationSlot1, NotifyOnTargetUpdated=True}"
                                            controls:MotionBehavior.IsContentTransitionEnabled="True"
                                            ContentTemplate="{StaticResource FeaturedLargeCardTemplate}"/>
                            <ContentControl Grid.Column="2" Content="{Binding HotRecommendationSlot2, NotifyOnTargetUpdated=True}"
                                            controls:MotionBehavior.IsContentTransitionEnabled="True"
                                            ContentTemplate="{StaticResource FeaturedLargeCardTemplate}"/>

                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ContentControl Grid.Row="0" Content="{Binding HotRecommendationSlot3, NotifyOnTargetUpdated=True}"
                                                controls:MotionBehavior.IsContentTransitionEnabled="True"
                                                ContentTemplate="{StaticResource FeaturedSmallCardTemplate}"/>
                                <ContentControl Grid.Row="2" Content="{Binding HotRecommendationSlot4, NotifyOnTargetUpdated=True}"
                                                controls:MotionBehavior.IsContentTransitionEnabled="True"
                                                ContentTemplate="{StaticResource FeaturedSmallCardTemplate}"/>
                            </Grid>

                            <ContentControl Grid.Column="6" Content="{Binding HotRecommendationSlot5, NotifyOnTargetUpdated=True}"
                                            controls:MotionBehavior.IsContentTransitionEnabled="True"
                                            ContentTemplate="{StaticResource FeaturedPeekCardTemplate}"/>

                            <Border Grid.Column="6" Panel.ZIndex="5" Width="58" HorizontalAlignment="Right"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#001A3046" Offset="0"/>
                                        <GradientStop Color="#F21A3046" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        </Border>

                        <Button Grid.Column="0" Panel.ZIndex="10"
                                Command="{Binding ShowPreviousRecommendationsCommand}"
                                Style="{StaticResource CarouselArrowButtonStyle}" ToolTip="上一组推荐">
                            <Path Data="M 27,9 L 10,28 L 27,47"
                                  Stroke="#D5DCE3" StrokeThickness="7"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                  StrokeLineJoin="Miter" Stretch="None"/>
                        </Button>
                        <Button Grid.Column="2" Panel.ZIndex="10"
                                Command="{Binding ShowNextRecommendationsCommand}"
                                Style="{StaticResource CarouselArrowButtonStyle}" ToolTip="下一组推荐">
                            <Path Data="M 9,9 L 26,28 L 9,47"
                                  Stroke="#D5DCE3" StrokeThickness="7"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                  StrokeLineJoin="Miter" Stretch="None"/>
                        </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding HotRecommendationPages}"
                              HorizontalAlignment="Center" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="PageDot" Width="18" Height="8" Margin="3,0"
                                    CornerRadius="4" Background="#526170"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="PageDot" Property="Background" Value="#F5F7F9"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="更多推荐" FontSize="24" FontWeight="SemiBold" Margin="6,0,0,12"
                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                <ItemsControl ItemsSource="{Binding MoreRecommendations}"
                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}"
                              ItemTemplate="{StaticResource GameResultRowTemplate}"/>
            </StackPanel>

            <!-- 搜索/入库开始后才显示运行信息。 -->
            <StackPanel Visibility="{Binding HasStartedSearch, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="搜索结果" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    <Button Command="{Binding ClearLogCommand}"
                            Style="{StaticResource SteamSecondaryButtonStyle}"
                            HorizontalAlignment="Right" Padding="10,5" ToolTip="返回推荐页">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE72B;" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="返回推荐"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Visibility="{Binding IsImportResultOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,12" CornerRadius="9" BorderThickness="1"
                        controls:MotionBehavior.IsRevealEnabled="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#17272A"/>
                            <Setter Property="BorderBrush" Value="#28534B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                    <Setter Property="Background" Value="#291F26"/>
                                    <Setter Property="BorderBrush" Value="#68404C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Width="4" Margin="0,12,0,12" CornerRadius="0,2,2,0"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#4CD67A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                            <Setter Property="Background" Value="#FF647C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Grid Margin="17,13,10,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#173D30"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                                <Setter Property="Background" Value="#482630"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:FontIcon FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon.Style>
                                        <Style TargetType="ui:FontIcon">
                                            <Setter Property="Glyph" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SteamGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                                    <Setter Property="Glyph" Value="&#xE711;"/>
                                                    <Setter Property="Foreground" Value="#FF788C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ImportResultTitle}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ImportResultDetail}" Margin="10,2,0,0" FontSize="13"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <WrapPanel Margin="0,10,0,0">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>

                                    <Border Background="#101B24" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="游戏" FontSize="12" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ImportResultGameCount, StringFormat={}{0} 个}"
                                                       Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#101B24" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="已入库 DLC" FontSize="12" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ImportResultImportedDlcCount, StringFormat={}{0} 个}"
                                                       Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SteamGreenBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#101B24" CornerRadius="6" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="DLC 总数" FontSize="12" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ImportResultTotalDlcCount}"
                                                       Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding CloseImportResultCommand}"
                                    Width="30" Height="30" Padding="0" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0" ToolTip="关闭结果">
                                <ui:FontIcon Glyph="&#xE711;" FontSize="12"
                                             Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Expander IsExpanded="False" Margin="0,0,0,12">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE756;" FontSize="14" Margin="0,0,8,0"
                                         Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                            <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LogLines.Count, StringFormat={}{0} 条}"
                                       FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        </StackPanel>
                    </Expander.Header>
                    <Border Style="{StaticResource SteamCardBorderStyle}" Padding="0" Height="220" Margin="0,6,0,0">
                        <Grid>
                            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Margin="16"
                                          PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding LogLines}"
                                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button x:Name="CopyLogButton" Content="复制日志"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,8,0" Padding="8,4" FontSize="12"
                                    Click="CopyLogButton_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Expander>

                <ItemsControl ItemsSource="{Binding SearchResults}"
                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}"
                              ItemTemplate="{StaticResource GameResultRowTemplate}"
                              Margin="0,0,0,8"
                              Visibility="{Binding SearchResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
