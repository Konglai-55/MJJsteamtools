<UserControl x:Class="SteamLuaManager.Views.ScriptDownloadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Match the library card's shadow, Gaussian radius, and seam stops. -->
        <DropShadowEffect x:Key="DiscoveryCardShadowEffect"
                          Color="#03080E" Direction="270"
                          ShadowDepth="7" BlurRadius="22" Opacity="0.48"/>
        <BlurEffect x:Key="DiscoveryCoverBlurEffect"
                    Radius="16" KernelType="Gaussian"
                    RenderingBias="Performance"/>
        <DataTemplate x:Key="GameTagTemplate">
            <Border Background="#284054" CornerRadius="5" Padding="7,4" Margin="0,0,5,5">
                <TextBlock Text="{Binding}" FontSize="11"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameFeatureTemplate">
            <Border Width="27" Height="27" Margin="0,0,5,5" CornerRadius="6"
                    Background="#284054" ToolTip="{Binding Label}"
                    AutomationProperties.Name="{Binding Label}">
                <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{Binding IconPath}" Fill="#A9C4D9"/>
                        <Path Data="{Binding CutoutPath}" Fill="#284054"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReviewStarSlotTemplate">
            <ui:FontIcon Glyph="&#xE735;" FontSize="12" Margin="0,0,3,0">
                <ui:FontIcon.Style>
                    <Style TargetType="ui:FontIcon">
                        <Setter Property="Foreground" Value="#63778A"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="True">
                                <Setter Property="Foreground" Value="#F2BF58"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:FontIcon.Style>
            </ui:FontIcon>
        </DataTemplate>

        <DataTemplate x:Key="DiscoveryCardTemplate">
            <controls:ClippingBorder Background="#223448" CornerRadius="10"
                                     BorderThickness="0" Margin="0,0,12,12"
                                     Effect="{StaticResource DiscoveryCardShadowEffect}"
                                     Style="{StaticResource SteamHoverLiftStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="172"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="1" Panel.ZIndex="-1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#25394D" Offset="0"/>
                                <GradientStop Color="#1E2E3F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Grid.Row="0" Height="172" Background="#182536" ClipToBounds="True">
                        <Image x:Name="DiscoveryCoverImage" Source="{Binding CoverUrl}" Tag="{Binding}"
                               ImageFailed="WideRecommendationImage_ImageFailed"
                               DataContextChanged="RecommendationImage_DataContextChanged"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="{Binding Source, ElementName=DiscoveryCoverImage}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                               Effect="{StaticResource DiscoveryCoverBlurEffect}"
                               IsHitTestVisible="False">
                            <Image.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.52"/>
                                    <GradientStop Color="#66000000" Offset="0.76"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Image.OpacityMask>
                        </Image>
                        <Rectangle Height="66" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0025394D" Offset="0"/>
                                    <GradientStop Color="#4825394D" Offset="0.48"/>
                                    <GradientStop Color="#FF25394D" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <StackPanel Grid.Row="1">
                    <Grid Margin="14,12,14,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                            <TextBlock Text="{Binding AppId, StringFormat=AppID {0}}" FontSize="11"
                                       Margin="0,3,0,0" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Price}" FontSize="13"
                                   Margin="12,2,0,0" Foreground="{DynamicResource SteamGreenBrush}"/>
                    </Grid>
                    <StackPanel Margin="14,1,14,7">
                        <ItemsControl ItemsSource="{Binding GameplayTags}"
                                      ItemTemplate="{StaticResource GameTagTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Features}"
                                      ItemTemplate="{StaticResource GameFeatureTemplate}" Margin="0,3,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border Background="#1B2B3B" CornerRadius="6" Padding="9,8" Margin="0,5,0,0"
                                ToolTip="{Binding Review.Tooltip}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl ItemsSource="{Binding Review.StarSlots}"
                                                  ItemTemplate="{StaticResource ReviewStarSlotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Grid.Column="1" Text="{Binding Review.StarsLabel}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="#F2BF58"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Review.Description}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Review.CountLabel}"
                                               Margin="8,0,0,0" FontSize="11"
                                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                </Grid>
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding Review.HasHotReview, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="{Binding Review.HotReview.Text}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="最高热评" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Review.HotReview.HelpfulLabel}"
                                                   FontSize="10" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Review.HotReview.Excerpt}"
                                               FontSize="11" LineHeight="16" MaxHeight="32" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid Margin="14,0,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ReleaseDate}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}" FontSize="11"/>
                        <Button Grid.Column="1" Tag="{Binding}" Click="OpenSteamStoreButton_Click"
                                Style="{DynamicResource RecommendationStoreButtonStyle}"
                                Width="31" Height="29" Padding="0" Margin="0,0,7,0"
                                Focusable="False" ToolTip="在 Steam 客户端中打开商店页"
                                AutomationProperties.Name="在 Steam 客户端中打开商店页">
                            <ui:FontIcon Glyph="&#xE719;" FontSize="15" Foreground="{DynamicResource SteamAccentBrush}"/>
                        </Button>
                        <Button Grid.Column="2" Content="一键入库"
                                Command="{Binding DataContext.DownloadGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{DynamicResource RecommendationImportButtonStyle}"
                                IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}"/>
                    </Grid>
                    </StackPanel>
                </Grid>
            </controls:ClippingBorder>
        </DataTemplate>

        <Style x:Key="RecommendationStoreButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A4053"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StoreButtonBody" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StoreButtonBody" Property="Background" Value="#344F65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecommendationImportButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SteamPrimaryButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ImportButtonBody" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ImportButtonBody" Property="Background" Value="{StaticResource SteamPrimaryButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ImportButtonBody" Property="Background" Value="{StaticResource SteamPrimaryButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GameResultRowTemplate">
            <controls:ClippingBorder BorderThickness="0" CornerRadius="10"
                                     Style="{StaticResource SteamHoverLiftStyle}"
                                     Effect="{StaticResource DiscoveryCardShadowEffect}"
                                     Padding="0" MinHeight="118" Margin="0,0,0,10">
                <controls:ClippingBorder.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#25394D" Offset="0"/>
                        <GradientStop Color="#1E2E3F" Offset="1"/>
                    </LinearGradientBrush>
                </controls:ClippingBorder.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="210" MinHeight="118"
                          ClipToBounds="True" Background="#182536">
                        <Image x:Name="ResultCoverImage" Source="{Binding CoverUrl}" Tag="{Binding}"
                               ImageFailed="WideRecommendationImage_ImageFailed"
                               DataContextChanged="RecommendationImage_DataContextChanged"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image Source="{Binding Source, ElementName=ResultCoverImage}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                               Effect="{StaticResource DiscoveryCoverBlurEffect}"
                               IsHitTestVisible="False">
                            <Image.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00000000" Offset="0.52"/>
                                    <GradientStop Color="#66000000" Offset="0.76"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Image.OpacityMask>
                        </Image>
                        <Rectangle Width="66" HorizontalAlignment="Right" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#25394D" Offset="0"/>
                                    <GradientStop Color="#1E2E3F" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#66000000" Offset="0.48"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,8,12,8">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SecondaryName}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSecondaryName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding AppId, StringFormat=AppID {0}}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding GameplayTags}"
                                      ItemTemplate="{StaticResource GameTagTemplate}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Features}"
                                      ItemTemplate="{StaticResource GameFeatureTemplate}" Margin="0,3,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                MinWidth="112" Margin="8,6,0,6">
                        <TextBlock Text="{Binding Price}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamGreenBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ReleaseDate}" FontSize="11" Margin="0,5,0,0"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Grid.Column="3" Tag="{Binding}" Click="OpenSteamStoreButton_Click"
                            Width="44" Height="42" Padding="0" Focusable="False" Margin="14,0,8,0"
                            VerticalAlignment="Center" Background="#293F51" BorderThickness="0"
                            ToolTip="在 Steam 客户端中打开商店页"
                            AutomationProperties.Name="在 Steam 客户端中打开商店页">
                        <ui:FontIcon Glyph="&#xE719;" FontSize="20" Foreground="{DynamicResource SteamAccentBrush}"/>
                    </Button>
                    <Button Grid.Column="4"
                            Command="{Binding DataContext.DownloadGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource SteamPrimaryButtonStyle}"
                            Width="86" Height="42" Padding="10,6" FontSize="15"
                            Focusable="False" Margin="0,0,14,0" VerticalAlignment="Center"
                            IsEnabled="{Binding DataContext.IsDownloading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolInvertConverter}}">
                        入库
                    </Button>
                </Grid>
            </controls:ClippingBorder>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="RecommendationScrollViewer"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="RecommendationScrollViewer_ScrollChanged">
        <StackPanel Margin="26,22,26,28" HorizontalAlignment="Stretch">

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="搜索并入库" Style="{StaticResource SteamPageTitleStyle}"/>
                    <TextBlock Text="按中文名、英文名、别名或 Steam AppID 查找；确认后写入本地游戏库"
                               Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1B3041" BorderThickness="0"
                        CornerRadius="8" Padding="14,9" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding ManifestCatalogCountText}" Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentDataSourceLabel, Mode=OneWay}"
                                   Foreground="{DynamicResource SteamAccentBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 紧凑搜索区 -->
            <Grid MaxWidth="720" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="40" Style="{StaticResource SteamSearchFieldBorderStyle}">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="17"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False" Foreground="#929AA3"/>
                <ui:AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                   Style="{StaticResource SteamSearchSuggestStyle}"
                                   ToolTip="搜索游戏名称或 AppID"
                                   AutomationProperties.Name="搜索游戏名称或 AppID"
                                   Height="40" HorizontalAlignment="Stretch"
                                   ItemsSource="{Binding SearchSuggestions}"
                                   TextMemberPath="Name" UpdateTextOnSelect="True"
                                   MaxSuggestionListHeight="360"
                                   QuerySubmitted="SearchBox_QuerySubmitted"
                                   SuggestionChosen="SearchBox_SuggestionChosen"
                                   TextChanged="SearchBox_TextChanged">
                    <ui:AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinWidth="380" Margin="4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SecondaryName}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSecondaryName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AppId, StringFormat=AppID {0}}"
                                           Margin="18,0,2,0" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ui:AutoSuggestBox.ItemTemplate>
                </ui:AutoSuggestBox>
                </Grid>
                </Border>
                <Button Grid.Column="1" Command="{Binding SearchCommand}"
                        Style="{StaticResource SteamPrimaryButtonStyle}"
                        Height="40" MinWidth="92" Margin="8,0,0,0"
                        IsEnabled="{Binding IsSearching, Converter={StaticResource BoolInvertConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE721;" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="搜索" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{Binding RefreshKeyCacheCommand}"
                        Style="{StaticResource SteamSecondaryButtonStyle}"
                        Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                        Visibility="{Binding IsLocalCacheMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        ToolTip="更新密钥缓存">
                    <ui:FontIcon Glyph="&#xE72C;" FontSize="15"/>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="标签筛选" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}" FontSize="12"/>
                <ComboBox Width="190" Height="34" ItemsSource="{Binding AvailableTags}"
                          SelectedItem="{Binding SelectedTag, Mode=TwoWay}"

                          ToolTip="按类型或功能标签筛选推荐和搜索结果"/>
                <TextBlock Text="{Binding FilteredSearchResultCount, StringFormat=显示 {0} 个结果}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SteamTextTertiaryBrush}" FontSize="12"
                           Visibility="{Binding HasStartedSearch, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- 首屏推荐：执行搜索或入库后让位给日志和结果。 -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasStartedSearch}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="为你推荐" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,48,2">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SteamGreenBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="每日轮换 · 新品、特惠、畅销与热门混合推荐 · 只看游戏" FontSize="12"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding FilteredHotRecommendations}"
                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}"
                              ItemTemplate="{StaticResource DiscoveryCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveUniformGrid MinItemWidth="310" MaxColumns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="9"
                        Padding="18" Margin="0,2,0,18"
                        Visibility="{Binding FilteredHotRecommendations.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <TextBlock Text="当前标签暂无推荐游戏，请切换其他标签。"
                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                </Border>
                <TextBlock Text="继续发现" FontSize="24" FontWeight="SemiBold" Margin="6,0,0,12"
                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                <ItemsControl ItemsSource="{Binding FilteredMoreRecommendations}"
                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}"
                              ItemTemplate="{StaticResource DiscoveryCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AdaptiveUniformGrid MinItemWidth="310" MaxColumns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Content="{Binding RecommendationLoadStatus}"
                        Command="{Binding LoadMoreRecommendationsCommand}"
                        IsEnabled="{Binding IsLoadingRecommendations, Converter={StaticResource BoolInvertConverter}}"
                        Visibility="{Binding HasMoreRecommendations, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource SteamSecondaryButtonStyle}"
                        HorizontalAlignment="Center" MinWidth="230" Margin="0,4,0,12" Padding="18,10"/>
            </StackPanel>

            <!-- 搜索/入库开始后才显示运行信息。 -->
            <StackPanel Visibility="{Binding HasStartedSearch, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="搜索结果" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    <Button Command="{Binding ClearLogCommand}"
                            Style="{StaticResource SteamSecondaryButtonStyle}"
                            HorizontalAlignment="Right" Padding="10,5" ToolTip="返回推荐页">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE72B;" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="返回推荐"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Visibility="{Binding IsImportResultOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,0,0,12" CornerRadius="9" BorderThickness="1"
                        controls:MotionBehavior.IsRevealEnabled="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#17272A"/>
                            <Setter Property="BorderBrush" Value="#28534B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                    <Setter Property="Background" Value="#291F26"/>
                                    <Setter Property="BorderBrush" Value="#68404C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Width="4" Margin="0,12,0,12" CornerRadius="0,2,2,0"
                                HorizontalAlignment="Left">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#4CD67A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                            <Setter Property="Background" Value="#FF647C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Grid Margin="17,13,10,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#173D30"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                                <Setter Property="Background" Value="#482630"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:FontIcon FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:FontIcon.Style>
                                        <Style TargetType="ui:FontIcon">
                                            <Setter Property="Glyph" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SteamGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="False">
                                                    <Setter Property="Glyph" Value="&#xE711;"/>
                                                    <Setter Property="Foreground" Value="#FF788C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ImportResultTitle}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ImportResultDetail}" Margin="10,2,0,0" FontSize="13"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <WrapPanel Margin="0,10,0,0">
                                    <WrapPanel.Style>
                                        <Style TargetType="WrapPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImportResultSuccess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </WrapPanel.Style>

                                    <Border Background="#101B24" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="游戏" FontSize="12" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ImportResultGameCount, StringFormat={}{0} 个}"
                                                       Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#101B24" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="已入库 DLC" FontSize="12" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ImportResultImportedDlcCount, StringFormat={}{0} 个}"
                                                       Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SteamGreenBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#101B24" CornerRadius="6" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="DLC 总数" FontSize="12" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ImportResultTotalDlcCount}"
                                                       Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding CloseImportResultCommand}"
                                    Width="30" Height="30" Padding="0" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0" ToolTip="关闭结果">
                                <ui:FontIcon Glyph="&#xE711;" FontSize="12"
                                             Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Expander IsExpanded="False" Margin="0,0,0,12">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE756;" FontSize="14" Margin="0,0,8,0"
                                         Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                            <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LogLines.Count, StringFormat={}{0} 条}"
                                       FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        </StackPanel>
                    </Expander.Header>
                    <Border Style="{StaticResource SteamCardBorderStyle}" Padding="0" Height="220" Margin="0,6,0,0">
                        <Grid>
                            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Margin="16"
                                          PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding LogLines}"
                                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button x:Name="CopyLogButton" Content="复制日志"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,8,8,0" Padding="8,4" FontSize="12"
                                    Click="CopyLogButton_Click" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Expander>

                <ItemsControl ItemsSource="{Binding FilteredSearchResults}"
                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}"
                              ItemTemplate="{StaticResource GameResultRowTemplate}"
                              Margin="0,0,0,8"
                              Visibility="{Binding FilteredSearchResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
