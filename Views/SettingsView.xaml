<UserControl x:Class="SteamLuaManager.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="设置" Style="{StaticResource SteamPageTitleStyle}"/>
            <TextBlock Text="按任务查找设置；调整即时生效，无需另行保存。"
                       Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="0"
                    SelectionChanged="TabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="14,12"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="7">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="False"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SteamHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SteamSurfaceRaisedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SteamHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="Transparent" Padding="0,0,4,0">
                            <StackPanel IsItemsHost="True" Orientation="Vertical" Background="Transparent"/>
                        </Border>
                        <Rectangle Grid.Column="1" Fill="{DynamicResource SteamDividerBrush}"
                                   Width="1" HorizontalAlignment="Left"/>
                        <ContentPresenter x:Name="ContentArea" Grid.Column="2"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- 基本设置 -->
            <TabItem AutomationProperties.Name="常规">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE713;" FontSize="16" Width="22" Margin="0,0,9,0"
                                     Foreground="{DynamicResource SteamAccentBrush}"/>
                        <TextBlock Text="常规" Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,12,0">
                    <StackPanel Margin="0,2,0,16">
                        <TextBlock Text="应用与 Steam" Style="{StaticResource SteamSectionTitleStyle}" FontSize="19"/>
                        <TextBlock Text="连接本机 Steam，管理内核与自动行为。"
                                   Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,3,0,18"/>

                        <ui:SettingsCard Header="Steam 路径" Margin="0,0,0,8"
                                         Description="指定本机 Steam 安装目录；不设置时自动检测"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding SteamPath, Mode=OneWay}"
                                         IsReadOnly="True" Width="240" Padding="8,6" Margin="0,0,4,0">
                                    <TextBox.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </TextBox.Background>
                                </TextBox>
                                <Button Content="浏览" Command="{Binding BrowseSteamPathCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                                <Button Content="重置" Command="{Binding ResetSteamPathCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="OpenSteamTool 管理" Margin="0,0,0,8"
                                         Description="安装或卸载适配的开源 Steam 内核"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Padding="9,5" Margin="0,0,8,0" CornerRadius="3"
                                        Background="{DynamicResource SteamSurfaceRaisedBrush}" BorderBrush="{DynamicResource SteamDividerBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="OpenSteamToolStatusDot" Width="7" Height="7"
                                                 Margin="0,0,7,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SteamTextTertiaryBrush}"/>
                                        <TextBlock x:Name="OpenSteamToolStatusText" Text="正在检测…"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="InstallOpenSteamToolButton" Content="安装"
                                        Click="InstallOpenSteamToolButton_Click"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button x:Name="UninstallOpenSteamToolButton" Content="卸载"
                                        Click="UninstallOpenSteamToolButton_Click"
                                        Style="{StaticResource SteamDangerButtonStyle}"
                                        Padding="12,6"/>
                            </StackPanel>
                        </ui:SettingsCard>

                        <TextBlock Text="运行行为" Style="{StaticResource SteamSectionTitleStyle}" Margin="0,22,0,10"/>
                        <ui:SettingsCard Header="自动监控" Margin="0,0,0,8"
                                         Description="文件变更时自动刷新游戏列表"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <ui:ToggleSwitch IsOn="{Binding IsAutoRefreshEnabled}"
                                             OnContent="开" OffContent="关"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="虚拟入库云同步" Margin="0,0,0,8"
                                         Description="新入库游戏默认关闭单游戏 Steam 云同步，避免无云许可时反复弹出同步错误"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <ui:ToggleSwitch IsOn="{Binding IsDisableCloudForImportedGamesEnabled}"
                                             OnContent="自动关闭" OffContent="保留云同步"
                                             AutomationProperties.Name="新入库游戏默认关闭 Steam 云同步"/>
                        </ui:SettingsCard>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 存档与文件 -->
            <TabItem AutomationProperties.Name="存档与文件">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE8B7;" FontSize="16" Width="22" Margin="0,0,9,0"
                                     Foreground="{DynamicResource SteamAccentBrush}"/>
                        <TextBlock Text="存档与文件" Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,12,0">
                    <StackPanel Margin="0,2,0,16">
                        <TextBlock Text="存档保险箱" Style="{StaticResource SteamSectionTitleStyle}" FontSize="19"/>
                        <TextBlock Text="设置备份位置、保留份数，并快速访问相关目录。"
                                   Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,3,0,18"/>
                        <ui:SettingsCard Header="存档保险箱" Margin="0,0,0,8"
                                         Description="设置快照保存位置和每个游戏的历史版本数量"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding SaveBackupPath, Mode=OneWay}" IsReadOnly="True"
                                             Width="250" Padding="8,6" Margin="0,0,6,0"
                                             ToolTip="留空时使用 LocalAppData 下的独立备份目录"/>
                                    <Button Content="选择目录" Command="{Binding BrowseSaveBackupPathCommand}"
                                            Padding="12,6" Margin="0,0,6,0"/>
                                    <Button Content="恢复默认" Command="{Binding ResetSaveBackupPathCommand}"
                                            Padding="12,6"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock Text="每个游戏保留" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                    <TextBox Text="{Binding SaveBackupRetention, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Width="56" Padding="7,4" Margin="8,0"/>
                                    <TextBlock Text="个历史版本（1–200）" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:SettingsCard>
                        <TextBlock Text="快捷目录" Style="{StaticResource SteamSectionTitleStyle}"
                                   Margin="0,24,0,10"/>
                        <ui:SettingsCard Header="Lua 清单文件夹" Margin="0,0,0,8"
                                         Description="查看 Steam 使用的 Lua 清单"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <Button Content="打开目录" Command="{Binding OpenLuaFolderCommand}"
                                    Padding="12,6" Margin="4,0">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="Bin 成就文件夹" Margin="0,0,0,8"
                                         Description="查看本机成就配置文件"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <Button Content="打开目录" Command="{Binding OpenBinStatsFolderCommand}"
                                    Padding="12,6" Margin="4,0">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="Steam 文件夹" Margin="0,0,0,8"
                                         Description="在文件管理器中打开 Steam"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <Button Content="打开目录" Command="{Binding OpenSteamFolderCommand}"
                                    Padding="12,6" Margin="4,0">
                                <Button.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </Button.Background>
                            </Button>
                        </ui:SettingsCard>
                        <ui:SettingsCard Header="缓存管理" Margin="0,0,0,8"
                                         Description="清理名称与封面缓存，不影响已入库游戏"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="清理缓存" Command="{Binding ClearCacheCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                                <Button Content="打开缓存目录" Command="{Binding OpenCacheFolderCommand}"
                                        Padding="12,6" Margin="4,0">
                                    <Button.Background>
                                        <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                        </ui:SettingsCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 显示设置 -->
            <TabItem AutomationProperties.Name="外观与体验">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE790;" FontSize="16" Width="22" Margin="0,0,9,0"
                                     Foreground="{DynamicResource SteamAccentBrush}"/>
                        <TextBlock Text="外观与体验" Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,20,0">
                    <StackPanel Margin="0,2,0,16">
                        <TextBlock Text="界面与反馈" Style="{StaticResource SteamSectionTitleStyle}" FontSize="19"/>
                        <TextBlock Text="控制主题、背景和页面中显示的辅助信息。"
                                   Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,3,0,18"/>

                        <ui:SettingsCard Header="主题模式" Margin="0,0,0,8"
                                         Description="当前使用深色外观，强调游戏封面与内容"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <Border Background="{DynamicResource SteamSurfaceRaisedBrush}" BorderBrush="{DynamicResource SteamDividerBrush}" BorderThickness="1"
                                    CornerRadius="2" Padding="10,5">
                                <TextBlock Text="深色 · 当前主题" Foreground="{DynamicResource SteamAccentBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="背景效果" Margin="0,0,0,8"
                                         Description="选择窗口背景效果"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                              <ComboBox ItemsSource="{Binding BackdropOptions}"
                                       SelectedValue="{Binding SelectedBackdrop}"
                                       SelectedValuePath="Value" DisplayMemberPath="Display"
                                       HorizontalAlignment="Left" Padding="8,4">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                              </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="刷新游戏信息入口" Margin="0,0,0,8"
                                         Description="在卡片设置、列表和表格中显示刷新封面与名称入口"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <ui:ToggleSwitch IsOn="{Binding IsCardRefreshVisible}"
                                             OnContent="开" OffContent="关"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="修改器推荐栏目" Margin="0,0,0,8"
                                         Description="修改器界面的热门推荐和最新发布栏目"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <ui:ToggleSwitch IsOn="{Binding IsShowTrainerSections}"
                                             OnContent="开" OffContent="关"/>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="日志复制按钮" Margin="0,0,0,8"
                                         Description="在提取和入库页的日志输出框右上角显示复制按钮"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <ui:ToggleSwitch IsOn="{Binding IsShowCopyLogButton}"
                                             OnContent="开" OffContent="关"/>
                        </ui:SettingsCard>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 接口设置 -->
            <TabItem AutomationProperties.Name="网络与来源">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE774;" FontSize="16" Width="22" Margin="0,0,9,0"
                                     Foreground="{DynamicResource SteamAccentBrush}"/>
                        <TextBlock Text="网络与来源" Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,20,0">
                    <StackPanel Margin="0,2,0,16">
                        <TextBlock Text="连接与数据源" Style="{StaticResource SteamSectionTitleStyle}" FontSize="19"/>
                        <TextBlock Text="选择代理、清单接口和封面节点，出现问题时可直接测速。"
                                   Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,3,0,18"/>

                        <ui:SettingsCard Header="网络与代理" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
                                         Description="自动检测系统代理，也可手动指定 HTTP 或 SOCKS5"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding ProxyModeOptions}"
                                              SelectedValue="{Binding ProxyMode, Mode=TwoWay}"
                                              SelectedValuePath="Value" DisplayMemberPath="Display"
                                              Width="132" Padding="8,4" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding ManualProxy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsManualProxyMode}"
                                             Width="180" Padding="8,6" Margin="0,0,8,0"
                                             ToolTip="示例：http://127.0.0.1:7890 或 socks5://127.0.0.1:7890"/>
                                    <Button Content="测试线路" Command="{Binding TestNetworkCommand}"
                                            IsEnabled="{Binding IsNetworkTesting, Converter={StaticResource BoolInvertConverter}}"
                                            Padding="12,6"/>
                                </StackPanel>
                                <TextBlock Text="自动模式依次读取环境变量和 Windows 系统代理；不可用时采用直连。"
                                           FontSize="11" Margin="0,7,0,0"
                                           Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            </StackPanel>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="入库接口" Margin="0,0,0,8"
                                         Description="选择游戏入库方式"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <ComboBox SelectedValue="{Binding DownloadMode, Mode=TwoWay}"
                                       SelectedValuePath="Tag" HorizontalAlignment="Left" Padding="8,4">
                                <ComboBox.Background>
                                    <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                </ComboBox.Background>
                                <ComboBoxItem Content="本地缓存仓库 V1" Tag="DepotKey"/>
                                <ComboBoxItem Content="本地缓存仓库 V2" Tag="DepotKey2"/>
                                <ComboBoxItem Content="远程清单仓库" Tag="Remote"/>
                            </ComboBox>
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="封面CDN节点" Margin="0,0,0,8"
                                         Description="选择优先使用的封面下载节点"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="测速" Command="{Binding TestCdnSpeedCommand}"
                                            IsEnabled="{Binding IsSpeedTesting, Converter={StaticResource BoolInvertConverter}}"
                                            Padding="12,6" Margin="0,0,4,0">
                                        <Button.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </Button.Background>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSpeedTesting, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressBar Value="{Binding SpeedTestProgress}"
                                                     Maximum="{Binding SpeedTestTotal}"
                                                     Width="100" Height="3" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedTestProgressText}" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding CdnEndpoints}"
                                              SelectedIndex="{Binding SelectedCdnIndex}"
                                                HorizontalAlignment="Left" Padding="8,4">
                                        <ComboBox.Background>
                                            <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                                        </ComboBox.Background>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </ui:SettingsCard>

                        <Border CornerRadius="8" Background="{DynamicResource LayerFillColorDefaultBrush}"
                                Margin="0,8,0,0" Padding="12,8"
                                Visibility="{Binding SpeedTestResults.Count, Converter={StaticResource NonZeroToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding SpeedTestResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding ColorCode}"
                                                     Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.9"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 隐私与数据 -->
            <TabItem AutomationProperties.Name="隐私与数据">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE72E;" FontSize="16" Width="22" Margin="0,0,9,0"
                                     Foreground="{DynamicResource SteamAccentBrush}"/>
                        <TextBlock Text="隐私与数据" Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0"
                              Background="Transparent" Padding="0,0,20,0">
                    <StackPanel Margin="0,2,0,16">
                        <TextBlock Text="隐私与数据" Style="{StaticResource SteamSectionTitleStyle}" FontSize="19"/>
                        <TextBlock Text="了解统计范围，随时控制匿名数据上报。"
                                   Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,3,0,18"/>
                        <ui:SettingsCard Header="匿名使用统计" Margin="0,0,0,8"
                                         Description="帮助了解 MJJsteamtools 的活跃设备数量和版本分布"
                                         ui:ControlHelper.CornerRadius="8">
                            <ui:SettingsCard.Background>
                                <SolidColorBrush Color="{DynamicResource SteamSurfaceColor}"/>
                            </ui:SettingsCard.Background>
                            <ui:ToggleSwitch IsOn="{Binding IsAnonymousUsageStatisticsEnabled}"
                                             OnContent="允许" OffContent="不允许"/>
                        </ui:SettingsCard>

                        <Border CornerRadius="8" Padding="16,14"
                                Background="{DynamicResource SteamSurfaceBrush}"
                                BorderBrush="{DynamicResource SteamDividerBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="发送的数据" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                <TextBlock Text="哈希后的随机安装标识、MJJsteamtools 版本、最近活跃时间"
                                           Margin="0,5,0,14" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>

                                <TextBlock Text="不会发送" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                <TextBlock Text="不会读取 Steam 账号、游戏库、文件内容、文件路径或硬件信息；MJJST 统计数据库不会保存请求 IP 地址"
                                           Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <ui:InfoBar Grid.Row="2"
                    IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                    Message="{Binding StatusMessage}"
                    Severity="Informational"
                    IsClosable="False"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0"
                    ui:ControlHelper.CornerRadius="8"/>

    </Grid>
</UserControl>
