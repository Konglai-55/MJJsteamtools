<Window x:Class="SteamLuaManager.Views.SteamFamilyConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="连接 Steam 家庭"
        Width="1040" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#171D25" Foreground="#F3F6F8"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#171D25" BorderBrush="#34495E" BorderThickness="0,0,0,1" Padding="18,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="连接 Steam 家庭" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="请在下方登录 Steam。应用只读取短期家庭库访问令牌，不会获取或保存你的密码。"
                               FontSize="11" Foreground="#ACB2B8" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="正在打开 Steam…" Foreground="#7FBCE8" HorizontalAlignment="Right"/>
                    <TextBlock Text="登录成功后窗口会自动关闭" FontSize="10" Foreground="#71869A" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="#0E141C">
            <wv2:WebView2 x:Name="Browser"/>
            <Border x:Name="LoadingOverlay" Background="#E6171D25">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="正在初始化安全登录窗口…" Foreground="#B9CCDD"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
