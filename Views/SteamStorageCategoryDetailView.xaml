<UserControl x:Class="SteamLuaManager.Views.SteamStorageCategoryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             Background="{DynamicResource SteamContentBrush}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Width="42" Height="38" Padding="0" Margin="0,0,12,0"
                    ToolTip="返回空间管家" Click="BackButton_Click">
                <ui:FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" FontSize="25" FontWeight="SemiBold"
                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                <TextBlock x:Name="PageSubtitleText" Margin="0,3,0,0" FontSize="12"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,22,0">
                    <TextBlock Text="条目" HorizontalAlignment="Right" FontSize="10"
                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    <TextBlock x:Name="ItemCountText" Text="—" HorizontalAlignment="Right"
                               Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="总占用" HorizontalAlignment="Right" FontSize="10"
                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    <TextBlock x:Name="TotalSizeText" Text="—" HorizontalAlignment="Right"
                               Margin="0,3,0,0" FontSize="17" FontWeight="SemiBold"
                               Foreground="#8AD129"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="12,9"
                Background="#172738" BorderBrush="#29445A" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <ui:FontIcon x:Name="StatusIcon" Glyph="&#xE895;" FontSize="14"
                             Margin="0,1,9,0" Foreground="#79C47B"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="正在读取明细…"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                <ProgressBar x:Name="LoadProgressBar" Grid.Column="2" Height="4"
                             Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListView x:Name="DetailList"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,8,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="6" Padding="15,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="14"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding AppIdText, Mode=OneWay}" FontSize="10"
                                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                        <TextBlock Text="  ·  " FontSize="10"
                                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding FileCountText, Mode=OneWay}" FontSize="10"
                                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path, Mode=OneWay}" ToolTip="{Binding Path, Mode=OneWay}"
                                               Margin="0,7,0,0" FontSize="10" TextTrimming="CharacterEllipsis"
                                               Foreground="#7FA6C2"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText, Mode=OneWay}"
                                           Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontSize="17" FontWeight="SemiBold" Foreground="#8AD129"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="打开目录" Padding="11,6" Tag="{Binding}"
                                            Click="OpenDirectoryButton_Click"/>
                                    <Button Content="{Binding ActionText, Mode=OneWay}" Padding="11,6"
                                            Margin="7,0,0,0" Background="#963B48" Foreground="White"
                                            BorderBrush="#B84D5C" Tag="{Binding}"
                                            Click="DeleteButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:FontIcon Glyph="&#xE838;" FontSize="34" HorizontalAlignment="Center"
                             Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                <TextBlock Text="这个分类目前没有可展示的内容" Margin="0,10,0,0"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
