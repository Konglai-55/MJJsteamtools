<UserControl x:Class="SteamLuaManager.Views.HomeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:modern="clr-namespace:iNKORE.UI.WPF.Modern;assembly=iNKORE.UI.WPF.Modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="SelectionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="16" Height="16">
                            <Border x:Name="Box"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{Binding Source={x:Static modern:ThemeManager.Current}, Path=ActualApplicationTheme, Converter={StaticResource ThemeToSelectionBrushConverter}}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Path x:Name="Mark"
                                  Data="M 3 8 L 6.2 11.2 L 13 4.4"
                                  Stroke="{Binding Source={x:Static modern:ThemeManager.Current}, Path=ActualApplicationTheme, Converter={StaticResource ThemeToSelectionBrushConverter}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource SystemAccentColorBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemAccentColorBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SteamCardActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextPrimaryBrush}"/>
            <Setter Property="Background" Value="#293C4D"/>
            <Setter Property="BorderBrush" Value="#3B5366"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background"
                                        Value="#35536A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background"
                                        Value="#213545"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SteamCardGearButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SteamCardActionButtonStyle}">
            <Setter Property="Background" Value="#253542"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GearButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GearButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GearButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardImportToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="controls:MotionBehavior.IsButtonFeedbackEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="60" Height="30">
                            <Border x:Name="ToggleTrack" CornerRadius="15"
                                    Background="#111B27"/>
                            <Ellipse x:Name="ToggleThumb" Width="24" Height="24"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="#AAAAAA">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource SteamAccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleThumb"
                                                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             To="30" Duration="0:0:0.167">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleThumb"
                                                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.167">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="#152333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteStarIconStyle" TargetType="ui:FontIcon">
            <Setter Property="Glyph" Value="&#xE734;"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Glyph" Value="&#xE735;"/>
                    <Setter Property="Foreground" Value="#FFD166"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#B8152333"/>
            <Setter Property="BorderBrush" Value="#36516A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FavoriteButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FavoriteButtonBorder" Property="Background" Value="#F0223448"/>
                                <Setter TargetName="FavoriteButtonBorder" Property="BorderBrush" Value="#5681A4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FavoriteButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteBentoToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{DynamicResource SteamSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteamDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BentoBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BentoBorder" Property="Background" Value="#2A3B4B"/>
                                <Setter TargetName="BentoBorder" Property="BorderBrush" Value="#466278"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BentoBorder" Property="Background" Value="#21394B"/>
                                <Setter TargetName="BentoBorder" Property="BorderBrush" Value="{DynamicResource SteamAccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BentoBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题与全局操作分开；搜索/筛选属于第二层工具栏。 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding LibraryTitle}" Style="{StaticResource SteamPageTitleStyle}"/>
                <TextBlock Text="{Binding RefreshProgressText}" FontSize="12" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding RefreshGamesCommand}"
                        Style="{StaticResource SteamSecondaryButtonStyle}"
                        Width="38" Height="38" Padding="0" Margin="0,0,5,0"
                        ToolTip="刷新游戏库">
                    <ui:FontIcon Glyph="&#xE72C;" FontSize="15"/>
                </Button>
                <Button Command="{Binding OpenLuaFolderCommand}"
                        Style="{StaticResource SteamSecondaryButtonStyle}"
                        Width="38" Height="38" Padding="0" Margin="0,0,8,0"
                        ToolTip="打开 Lua 目录">
                    <ui:FontIcon Glyph="&#xE838;" FontSize="15"/>
                </Button>
                <Button Command="{Binding AddFilesCommand}"
                        Style="{StaticResource SteamPrimaryButtonStyle}"
                        Height="38" Padding="14,7">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE710;" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="导入 Lua/Bin" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Width="300" Height="38" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SteamSearchFieldBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="17"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False" Foreground="#929AA3"/>
                        <ui:AutoSuggestBox x:Name="SearchBox" Grid.Column="1"
                                           Style="{StaticResource SteamSearchSuggestStyle}"
                                           QuerySubmitted="SearchBox_QuerySubmitted"
                                           TextChanged="SearchBox_TextChanged"
                                           ToolTip="搜索游戏名称或 AppID"
                                           AutomationProperties.Name="搜索游戏名称或 AppID"
                                           HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
                <Button x:Name="LibraryFilterButton" Grid.Column="1"
                        Style="{StaticResource SteamSearchFilterButtonStyle}"
                        Margin="4,0,0,0"
                        ToolTip="筛选游戏" Click="LibraryFilterButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="LibraryFilterMenu">
                            <MenuItem x:Name="AllGamesFilterItem" Header="全部游戏" Tag="全部游戏"
                                      IsCheckable="True" Click="LibraryFilterMenuItem_Click"/>
                            <MenuItem x:Name="EnabledGamesFilterItem" Header="已启用入库" Tag="已启用入库"
                                      IsCheckable="True" Click="LibraryFilterMenuItem_Click"/>
                            <MenuItem x:Name="DisabledGamesFilterItem" Header="已禁用入库" Tag="已禁用入库"
                                      IsCheckable="True" Click="LibraryFilterMenuItem_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <ui:FontIcon Glyph="&#xE71C;" FontSize="14"
                                 Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                </Button>
            </Grid>

            <ToggleButton Grid.Column="1"
                          IsChecked="{Binding IsFavoritesView, Mode=TwoWay}"
                          Style="{StaticResource FavoriteBentoToggleStyle}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          ToolTip="只查看收藏的游戏">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE734;" FontSize="15" Foreground="#FFD166"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="收藏游戏" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="7" Background="#2A000000">
                        <TextBlock Text="{Binding FavoriteCount}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                    </Border>
                </StackPanel>
            </ToggleButton>

        </Grid>

        <!-- 批量操作栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,16"
              Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding SelectAllCommand}" Padding="10,6" Margin="0,0,6,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="全选" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearSelectionCommand}" Padding="10,6" Margin="6,0,16,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="取消选择" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,4,16,4"/>
                <Button Command="{Binding BatchEnableCommand}" Padding="10,6" Margin="0,0,6,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="批量启用" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BatchDisableCommand}" Padding="10,6" Margin="6,0,6,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="批量禁用" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding BatchDeleteCommand}" Padding="10,6" Margin="6,0,0,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="#FFFF4444">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="批量删除" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSelectionModeCommand}" Padding="10,6" Margin="0,0,16,0"
                        Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="退出批量管理" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="已选择 "/>
                    <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                    <Run Text=" 个游戏"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <ui:InfoBar Grid.Row="3"
                    IsOpen="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                    Message="{Binding StatusMessage}"
                    Severity="Success"
                    IsClosable="True"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,4"
                    ui:ControlHelper.CornerRadius="8">
            <ui:InfoBar.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                </Style>
            </ui:InfoBar.Resources>
        </ui:InfoBar>

        <!-- Loading提示 -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,40,0,0"
                    Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}">
            <ui:ProgressRing IsActive="True" Width="32" Height="32" Margin="0,0,0,12"/>
            <TextBlock Text="正在加载游戏信息..." HorizontalAlignment="Center" FontSize="15"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{Binding RefreshProgressText}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- 游戏内容区域（非加载 且 有游戏时显示） -->
        <Grid Grid.Row="4" Visibility="{Binding IsRefreshing, Converter={StaticResource InvertedBoolToVisibilityConverter}}">

            <!-- 卡片模式 -->
            <ScrollViewer x:Name="CardScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="GamesScrollViewer_ScrollChanged"
                          SizeChanged="GamesScrollViewer_SizeChanged"
                          Loaded="ViewModeContainer_Loaded">
                <ItemsControl x:Name="CardItemsControl" ItemsSource="{Binding Games}" Margin="0,0,0,16"
                              HorizontalAlignment="Left"
                              ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ClippingBorder x:Name="CardRoot"
                                    Style="{StaticResource SteamHoverLiftStyle}"
                                    Margin="0,0,14,14"
                                    Width="{Binding GameCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource SteamDividerBrush}"
                                    BorderThickness="1"
                                    Tag="{Binding}">
                                <controls:ClippingBorder.Background>
                                    <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}"/>
                                </controls:ClippingBorder.Background>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 16:9 横向封面 -->
                                    <Grid Grid.Row="0" Background="#182536"
                                          Height="{Binding GameCardCoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               x:Name="CoverImage"/>
                                        <Rectangle x:Name="DisabledCoverOverlay"
                                                   Fill="#60000000" Opacity="0"
                                                   IsHitTestVisible="False"/>
                                        <CheckBox Style="{StaticResource SelectionCheckBoxStyle}" IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Top" HorizontalAlignment="Left"
                                                  Margin="8"
                                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
                                        <Button Style="{StaticResource FavoriteIconButtonStyle}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="收藏或取消收藏">
                                            <ui:FontIcon Style="{StaticResource FavoriteStarIconStyle}" FontSize="17"/>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="14,12,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GameNameText" Grid.Column="0" Text="{Binding GameName}"
                                                   FontWeight="SemiBold" FontSize="15"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding GameName}"
                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        <Border Grid.Column="1" Margin="8,0,4,0" Padding="7,2"
                                                CornerRadius="8" Background="#162537"
                                                VerticalAlignment="Center"
                                                ToolTip="已安装显示本机实际占用；未安装显示 Steam 商店建议存储空间">
                                            <TextBlock Text="{Binding InstallSizeText}" FontSize="10"
                                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                        </Border>
                                        <ToggleButton Grid.Column="2"
                                                      Tag="{Binding}"
                                                      Style="{StaticResource CardImportToggleStyle}"
                                                      IsChecked="{Binding IsDisabled, Converter={StaticResource BoolInvertConverter}, Mode=OneWay}"
                                                      Margin="12,-3,-4,0"
                                                      VerticalAlignment="Center"
                                                      ToolTip="开启：已入库；关闭：禁止入库"
                                                      Click="CardImportToggle_Click"/>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="14,3,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="12"
                                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                                   x:Name="AppIdText">
                                            <Run Text="AppID: "/><Run Text="{Binding AppId, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="● 已固定" FontSize="10"
                                                   Foreground="{DynamicResource SteamAccentBrush}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManifestPinned}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- 与参考图一致的主操作 + 独立齿轮菜单 -->
                                    <Grid Grid.Row="3" Margin="14,14,14,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Tag="{Binding}" Click="OpenLibraryButton_Click"
                                                Style="{StaticResource SteamCardActionButtonStyle}" Margin="0,0,2,0"
                                                ToolTip="在 Steam 库详情页中打开">
                                            <TextBlock Text="从库里打开" FontSize="14" Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        </Button>
                                        <Button Grid.Column="1" Tag="{Binding}" Click="MoreButton_Click"
                                                Style="{StaticResource SteamCardGearButtonStyle}"
                                                Padding="0"
                                                AutomationProperties.Name="打开游戏详情"
                                                ToolTip="游戏详情">
                                            <ui:FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </controls:ClippingBorder>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.38" Duration="0:0:0.24"/>
                                                <DoubleAnimation Storyboard.TargetName="DisabledCoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.24"/>
                                                <DoubleAnimation Storyboard.TargetName="GameNameText"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.62" Duration="0:0:0.24"/>
                                                <DoubleAnimation Storyboard.TargetName="AppIdText"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.62" Duration="0:0:0.24"/>
                                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#28313A" Duration="0:0:0.24"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.24"/>
                                                <DoubleAnimation Storyboard.TargetName="DisabledCoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.24"/>
                                                <DoubleAnimation Storyboard.TargetName="GameNameText"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.24"/>
                                                <DoubleAnimation Storyboard.TargetName="AppIdText"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.24"/>
                                                <ColorAnimation Storyboard.TargetName="CardRoot"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#1D2936" Duration="0:0:0.24"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 列表模式 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="GamesScrollViewer_ScrollChanged"
                          SizeChanged="GamesScrollViewer_SizeChanged"
                          Loaded="ViewModeContainer_Loaded"
                          Visibility="Collapsed">
                <StackPanel Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding Games}"
                                  ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Margin="0,0,0,6" Padding="12"
                                        Style="{StaticResource SteamHoverLiftStyle}"
                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource SelectionCheckBoxStyle}" IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

                                        <controls:ClippingBorder Grid.Column="1" CornerRadius="6" ClipToBounds="True"
                                                 Margin="6,0,0,0"
                                                 Width="120" Height="52" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                 BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Rectangle Fill="#60000000">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Grid>
                                        </controls:ClippingBorder>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0">
                                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" FontSize="14"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="AppID: "/>
                                                    <Run Text="{Binding AppId, Mode=OneWay}"/>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="10" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource SystemAccentColorBrush}"
                                                           Text="● 版本已固定">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsManifestPinned}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Style="{StaticResource FavoriteIconButtonStyle}"
                                                    Width="30" Height="30" Margin="0,0,3,0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="收藏或取消收藏">
                                                <ui:FontIcon Style="{StaticResource FavoriteStarIconStyle}" FontSize="14"/>
                                            </Button>
                                            <Button Visibility="{Binding DataContext.IsCardRefreshVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RefreshSingleGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,4" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    ToolTip="重新获取封面和名称">
                                                <ui:FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="MoreButton_Click"
                                                    Padding="8,6" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    AutomationProperties.Name="打开游戏详情"
                                                    ToolTip="游戏详情">
                                                <ui:FontIcon Glyph="&#xE713;" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 表格模式 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="GamesScrollViewer_ScrollChanged"
                          SizeChanged="GamesScrollViewer_SizeChanged"
                          Loaded="ViewModeContainer_Loaded"
                          Visibility="Collapsed">
                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                     <Border Grid.Row="0" CornerRadius="8,8,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Width="16"
                                       Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Fill="Transparent"/>
                            <TextBlock Grid.Column="1" Text="游戏名称" FontWeight="SemiBold" FontSize="13" Padding="14,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="版本状态" FontWeight="SemiBold" FontSize="13" Padding="10,9"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="入库状态" FontWeight="SemiBold" FontSize="13" Padding="10,9"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="AppID" FontWeight="SemiBold" FontSize="13" Padding="14,10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="5" FontWeight="SemiBold" FontSize="13" Padding="12,10"/>
                        </Grid>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0">
                                    <Border.Background>
                                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                                    </Border.Background>
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource SelectionCheckBoxStyle}" IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
                                        <TextBlock Grid.Column="1" Text="{Binding GameName}" FontSize="13" Padding="14,9"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" FontSize="13" Padding="10,9"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="未固定"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManifestPinned}" Value="True">
                                                            <Setter Property="Text" Value="已固定"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" FontSize="13" Padding="10,9"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="已启用"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="Text" Value="已禁用"/>
                                                            <Setter Property="Foreground" Value="#FF888888"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding AppId}" FontSize="13" Padding="14,9"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource FavoriteIconButtonStyle}"
                                                    Width="28" Height="28" Margin="0,0,2,0"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="收藏或取消收藏">
                                                <ui:FontIcon Style="{StaticResource FavoriteStarIconStyle}" FontSize="13"/>
                                            </Button>
                                            <Button Visibility="{Binding DataContext.IsCardRefreshVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RefreshSingleGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,4" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    ToolTip="重新获取封面和名称">
                                                <ui:FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                            </Button>
                                            <Button Tag="{Binding}" Click="MoreButton_Click"
                                                    Padding="6,4" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    AutomationProperties.Name="打开游戏详情"
                                                    ToolTip="游戏详情">
                                                <ui:FontIcon Glyph="&#xE713;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 空状态提示 -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                    Visibility="{Binding Games.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
            <ui:FontIcon Glyph="&#xE7F0;" FontSize="48" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{Binding EmptyStateHint}" FontSize="13"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        </Grid>

        <!-- 游戏详情页：在游戏库内容区域内覆盖显示，返回时保留原滚动位置。 -->
        <ContentControl x:Name="GameDetailHost" Panel.ZIndex="140"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>

        <!-- 慢速获取浮层 -->
        <Border Visibility="{Binding IsRefreshSlow, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.72" IsHitTestVisible="True">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <Border CornerRadius="12" Padding="32"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                        MaxWidth="400">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource CardBackgroundFillColorDefault}" Opacity="0.45"/>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" Width="280">

                        <ui:FontIcon Glyph="&#xE7BA;" FontSize="36" HorizontalAlignment="Center"
                                      Foreground="{DynamicResource SystemAccentColorBrush}"/>
                        <TextBlock Text="获取游戏信息较慢" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <TextBlock Text="{Binding RefreshProgressText}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                        <ui:ProgressRing IsActive="True" Width="24" Height="24" Margin="0,0,0,12"/>

                        <TextBlock Text="已超过20秒，后台仍在尝试获取中..."
                                   FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <TextBlock Text="提示：&#x0a;• 可尝试开启 VPN / 代理&#x0a;• 或前往 设置 → 封面CDN节点 切换试试"
                                   FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8,0,16"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="后台获取" Command="{Binding DismissSlowOverlayCommand}"
                                    Padding="20,10" MinWidth="100" Margin="0,0,6,0"
                                    FontWeight="SemiBold"/>
                            <Button Content="取消获取" Command="{Binding CancelRefreshCommand}"
                                    Padding="20,10" MinWidth="100" Margin="6,0,0,0"
                                    Style="{StaticResource SteamPrimaryButtonStyle}"
                                    FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 游戏卡片扩展菜单（与悬浮按钮面板同类实现） -->
        <Canvas x:Name="CardMenuCanvas" Panel.ZIndex="90" IsHitTestVisible="True">
            <Border x:Name="CardMenuPanel" Canvas.Left="0" Canvas.Top="0"
                    Width="190" Padding="4" CornerRadius="0"
                    Background="#434D5D"
                    BorderBrush="#5B6675" BorderThickness="1"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0"
                    MouseLeave="CardMenuPanel_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="1"/>
                </Border.RenderTransform>
                <ItemsControl x:Name="CardMenuList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Divider" Height="1" Margin="4,2"
                                        Background="#697484"
                                        Visibility="Collapsed"/>
                                <Border x:Name="MenuItemBorder" Padding="14,9" MinHeight="38" Cursor="Hand" CornerRadius="0"
                                        Background="Transparent" BorderThickness="0"
                                        Tag="{Binding}"
                                        MouseLeftButtonDown="CardMenuItem_MouseLeftButtonDown"
                                        MouseEnter="CardMenuItem_MouseEnter"
                                        MouseLeave="CardMenuItem_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="#F0F2F4"/>
                                        <ui:FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="10" Margin="2,0,0,0"
                                                     Foreground="#B8C0C8"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding HasSubmenu, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="MenuItemBorder" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border x:Name="CardSubmenuPanel" Canvas.Left="0" Canvas.Top="0"
                    Width="226" Padding="4" CornerRadius="0"
                    Background="#434D5D"
                    BorderBrush="#5B6675" BorderThickness="1"
                    Visibility="Collapsed"
                    RenderTransformOrigin="0.5,0"
                    MouseEnter="CardSubmenuPanel_MouseEnter"
                    MouseLeave="CardSubmenuPanel_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.5"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform ScaleY="1"/>
                </Border.RenderTransform>
                <ItemsControl x:Name="CardSubmenuList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border x:Name="Divider" Height="1" Margin="4,2"
                                        Background="#697484"
                                        Visibility="Collapsed"/>
                                <Border x:Name="SubmenuItemBorder" Padding="14,9" MinHeight="38" CornerRadius="0"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Tag="{Binding}"
                                    MouseLeftButtonDown="CardSubmenuItem_MouseLeftButtonDown"
                                    MouseEnter="CardSubmenuItem_MouseEnter"
                                    MouseLeave="CardSubmenuItem_MouseLeave">
                                    <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center"
                                               Foreground="#F0F2F4"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="SubmenuItemBorder" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Canvas>

    </Grid>
</UserControl>
