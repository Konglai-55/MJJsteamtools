<Window x:Class="SteamLuaManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Title="MJJsteamtools"
        Icon="pack://application:,,,/Assets/brand-app.png"
        Height="800" Width="1180"
        MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        ui:WindowHelper.SystemBackdropType="Acrylic10"
        ui:WindowHelper.CornerStyle="Default"
        ui:WindowHelper.FixMaximizedWindow="True"
        Background="{DynamicResource SteamShellBrush}"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="15"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource SteamShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Steam 客户端式全局标题栏：品牌、当前位置、当前账号与系统窗口按钮。 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SteamShellBrush}"
                BorderBrush="{DynamicResource SteamDividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0,0,0">
                <Grid.Resources>
                    <Style x:Key="CaptionButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="46"/>
                        <Setter Property="Height" Value="64"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#8F9AA5"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="controls:MotionBehavior.IsButtonFeedbackEnabled" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CaptionButtonBackground"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CaptionButtonBackground" Property="Background" Value="#293440"/>
                                            <Setter Property="Foreground" Value="#D7DCE1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CaptionButtonBackground" Property="Background" Value="#35414D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#9B1F15"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SteamQuickActionButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="34"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#9BA5AF"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="controls:MotionBehavior.IsButtonFeedbackEnabled" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="QuickActionBackground"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="QuickActionBackground" Property="Background" Value="#293440"/>
                                            <Setter Property="Foreground" Value="#D6D7D8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="QuickActionBackground" Property="Background" Value="#35414D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="138"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource BrandMarkGeometry}"
                      Width="23" Height="20" Stretch="Uniform" Fill="#D6D7D8"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="MJJSteamtools" FontSize="15"
                           FontWeight="Normal" VerticalAlignment="Center"
                           Foreground="#D6D7D8"/>
                <TextBlock x:Name="CurrentPageTitleText" Grid.Column="2" Text="游戏库" Visibility="Collapsed"
                           FontSize="14" VerticalAlignment="Center" Margin="22,0,0,0"
                           Foreground="#C9CBCD"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource SteamQuickActionButtonStyle}"
                            Click="StartSteamButton_Click" ToolTip="启动 Steam">
                        <ui:FontIcon Glyph="&#xE768;" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource SteamQuickActionButtonStyle}"
                            Click="RestartSteamButton_Click" ToolTip="重启 Steam">
                        <ui:FontIcon Glyph="&#xE777;" FontSize="15"/>
                    </Button>
                </StackPanel>

                <Button x:Name="TopAccountButton" Grid.Column="4" Height="34" MinWidth="112"
                        Padding="4,0,7,0" VerticalAlignment="Center" Margin="0,0,12,0"
                        Cursor="Hand" Focusable="False"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="TopAccountButton_Click" MouseLeave="TopAccountButton_MouseLeave">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="AccountButtonBackground" CornerRadius="2"
                                    Padding="{TemplateBinding Padding}" Background="#222B37">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="AccountButtonBackground" Property="Background" Value="#2A3544"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="AccountButtonBackground" Property="Background" Value="#344153"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="2" VerticalAlignment="Center"
                                Background="#111821" BorderBrush="#405065" BorderThickness="1">
                            <Grid>
                                <ui:FontIcon Glyph="&#xE77B;" FontSize="14"
                                             Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="TopAccountAvatar" Width="24" Height="24"
                                       Stretch="UniformToFill" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TopAccountName" Grid.Column="1" Text="未登录 Steam"
                                   MaxWidth="150" Margin="7,0,4,0" FontSize="13"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SteamAccentBrush}"/>
                        <ui:FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10"
                                     VerticalAlignment="Center" Foreground="#5AA9D6"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"
                            ToolTip="最小化">
                        <ui:FontIcon Glyph="&#xE921;" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click"
                            ToolTip="最大化">
                        <ui:FontIcon x:Name="MaximizeButtonGlyph" Glyph="&#xE922;" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click"
                            ToolTip="关闭">
                        <ui:FontIcon Glyph="&#xE8BB;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="NavigationShell" ClipToBounds="False">
        <ui:NavigationView x:Name="NavView"
                           PaneDisplayMode="Left"
                           IsPaneOpen="True"
                           IsPaneToggleButtonVisible="False"
                           OpenPaneLength="214"
                           CompactPaneLength="64"
                           IsSettingsVisible="False"
                           IsBackEnabled="False"
                           IsBackButtonVisible="Collapsed"
                           SelectionChanged="NavView_SelectionChanged"
                           Background="{DynamicResource SteamContentBrush}">
            <ui:NavigationView.Resources>
                <sys:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</sys:Double>
                <sys:Double x:Key="NavigationViewSelectionIndicatorWidth">4</sys:Double>
                <sys:Double x:Key="NavigationViewSelectionIndicatorHeight">20</sys:Double>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{DynamicResource SteamSidebarColor}"/>
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{DynamicResource SteamSidebarColor}"/>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{DynamicResource SteamContentColor}"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#213746"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#294457"/>
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#1C3040"/>
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{DynamicResource SteamAccentColor}"/>
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{DynamicResource SteamAccentColor}"/>
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{DynamicResource SteamAccentColor}"/>
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{DynamicResource SteamAccentColor}"/>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>

                <Style x:Key="PrimaryNavItemStyle" TargetType="ui:NavigationViewItem">
                    <Setter Property="Height" Value="46"/>
                    <Setter Property="Margin" Value="6,1"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{DynamicResource SteamTextPrimaryBrush}"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>

                <Style x:Key="ChildNavItemStyle" TargetType="ui:NavigationViewItem">
                    <Setter Property="Height" Value="46"/>
                    <Setter Property="Margin" Value="36,0,6,0"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="{DynamicResource SteamTextSecondaryBrush}"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>

            </ui:NavigationView.Resources>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItemHeader x:Name="LibraryNavHeader" Content="游戏与入库"
                                             Height="30" Margin="8,8,0,2" FontSize="11"
                                             Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                <ui:NavigationViewItem x:Name="HomeItem" Content="游戏库" Tag="Home" ToolTip="游戏库"
                                       Style="{StaticResource PrimaryNavItemStyle}" Margin="6,6,6,0">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xEA8A;" Style="{StaticResource SolidNavIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="ScriptDownloadItem" Content="搜索入库" Tag="ScriptDownload" ToolTip="搜索入库"
                                       Style="{StaticResource ChildNavItemStyle}">
                    <ui:NavigationViewItem.Icon>
                        <Path Data="M806.784272,716.288385 L1004.992024,914.432137 A63.99992,63.99992 0 0 1 914.432137,1004.992024 L716.288385,806.784272 A447.99944,447.99944 0 1 1 806.784272,716.288385 Z M448.00072,768.00032 A319.9996,319.9996 0 1 0 448.00072,128.00112 A319.9996,319.9996 0 0 0 448.00072,768.00032 Z"
                              Style="{StaticResource SolidNavPathIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="ExtractionItem" Content="Lua 提取" Tag="Extraction" ToolTip="Lua 提取"
                                       Style="{StaticResource ChildNavItemStyle}">
                    <ui:NavigationViewItem.Icon>
                        <Path Data="M512,64 C264.6,64 64,264.6 64,512 S264.6,960 512,960 S960,759.4 960,512 S759.4,64 512,64 Z M341.8,346.2 L590.4,346.2 C608.7,346.2 623.6,361 623.6,379.4 S608.8,412.6 590.4,412.6 L341.8,412.6 C323.5,412.6 308.6,397.8 308.6,379.4 S323.7,346.2 341.8,346.2 Z M590.5,677.8 L341.8,677.8 C323.5,677.8 308.6,663 308.6,644.6 C308.6,626.3 323.4,611.4 341.8,611.4 L590.4,611.4 C608.7,611.4 623.6,626.2 623.6,644.6 C623.6,662.9 608.8,677.8 590.5,677.8 Z M747,526.3 L657.6,590.4 C653.6,594.4 648.3,596.6 642.7,596.6 S631.8,594.4 627.8,590.4 S621.7,581.1 621.7,575.3 S623.9,564.2 627.8,560.2 L655.5,532 L330,532 C318.5,532 308.8,522.3 308.8,510.8 S318.5,489.6 330,489.6 L654.4,489.6 L626.6,461.4 C622.7,457.5 620.5,452.1 620.5,446.4 S622.6,435.4 626.5,431.5 C630.4,427.4 635.5,425.2 641.1,425.1 C646.9,425 652.4,427.2 656.5,431.4 L747,497 C750.7,500.9 752.7,506.1 752.7,511.7 S750.6,521 747,526.3 Z"
                              Style="{StaticResource SolidNavPathIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItemHeader x:Name="ManagementNavHeader" Content="管理与维护"
                                             Height="30" Margin="8,12,0,2" FontSize="11"
                                             Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                <ui:NavigationViewItem x:Name="SaveVaultItem" Content="存档保险箱" Tag="SaveVault" ToolTip="存档保险箱"
                                       Style="{StaticResource PrimaryNavItemStyle}" Margin="6,1">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE8D5;" Style="{StaticResource SolidNavIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="FamilyLibraryItem" Content="家庭库" Tag="FamilyLibrary" ToolTip="家庭库"
                                       Style="{StaticResource PrimaryNavItemStyle}">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xEA8C;" Style="{StaticResource SolidNavIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="TrainerItem" Content="游戏修改器" Tag="Trainer" ToolTip="游戏修改器"
                                       Style="{StaticResource PrimaryNavItemStyle}">
                    <ui:NavigationViewItem.Icon>
                        <Path Data="M771.8,266.88 L252.2,266.88 C116.61,266.88 6.7,376.79 6.7,512.38 C6.7,647.97 116.61,757.88 252.2,757.88 L771.8,757.88 C907.39,757.88 1017.3,647.97 1017.3,512.38 C1017.3,376.79 907.39,266.88 771.8,266.88 Z M385,543.88 L311.36,543.88 L311.36,617.56 C311.36,633.8 299.44,647.9 283.36,649.83 A32,32 0 0 1 247.36,618.07 L247.36,543.88 L173.67,543.88 C157.43,543.88 143.33,531.96 141.4,515.88 A32,32 0 0 1 173.16,479.88 L247.36,479.88 L247.36,406.2 C247.36,389.96 259.28,375.86 275.36,373.93 A32,32 0 0 1 311.36,405.69 L311.36,479.88 L385.55,479.88 A32,32 0 0 1 417.31,515.88 C415.38,532 401.28,543.88 385,543.88 Z M680,499.67 A53.16,53.16 0 1 1 680,606 A53.16,53.16 0 0 1 680,499.67 Z M790,578.33 A53.16,53.16 0 1 1 790,684.65 A53.16,53.16 0 0 1 790,578.33 Z"
                              Style="{StaticResource SolidNavPathIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem x:Name="UtilityToolsItem" Content="实用工具" Tag="UtilityTools" ToolTip="实用工具"
                                       Style="{StaticResource PrimaryNavItemStyle}" Margin="6,1">
                    <ui:NavigationViewItem.Icon>
                        <Path Data="M1025,343.865677 C1025,533.991409 869.660445,678.531042 679.534713,677.731355 C655.244201,677.631394 631.553456,675.032409 608.762358,670.134323 C587.670597,665.63608 565.679187,672.234503 550.385162,687.528528 L270.094651,967.81804 C239.306678,998.606013 198.722531,1014 158.138383,1014 C117.554235,1014 76.970089,998.606013 46.18196,967.81804 C15.393987,937.030067 0,896.44592 0,855.861773 C0,815.277626 15.393987,774.693479 46.18196,743.905506 L327.172199,462.915267 C342.366264,447.721202 348.963687,425.829754 344.565404,404.837954 C339.767278,382.046857 337.268254,358.356111 337.268254,334.16556 C337.268254,144.839516 491.707926,-9.700156 681.333853,-9.700156 C706.124169,-9.700156 730.31472,-7.101171 753.705583,-2.103124 C759.903162,-0.803632 766.100741,0.695783 772.198359,2.395119 C795.789144,8.892581 803.586098,38.481023 786.292853,55.874229 L772.698163,69.468919 L613.460365,228.606755 C590.469346,251.597774 577.774305,282.385748 577.774305,325.372862 C577.774305,358.260015 590.469346,389.047989 613.460365,412.039008 C636.451384,435.030027 667.239358,447.725068 710.226472,447.725068 C743.113625,447.725068 773.901599,435.030027 796.892618,412.039008 L959.425381,249.606677 C976.718626,232.313432 1006.407029,240.010426 1012.90449,263.701171 C1014.603826,269.798789 1016.10324,275.996368 1017.402733,282.193948 C1022.400781,305.584811 1025,329.775362 1025,343.865677 Z"
                              Style="{StaticResource SolidNavPathIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="SettingsItem" Content="设置" Tag="Settings" ToolTip="设置" Padding="12,0" Margin="6,2" FocusVisualStyle="{x:Null}">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xF8B0;" Style="{StaticResource SolidNavIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="AboutItem" Content="关于" Tag="About" ToolTip="关于" Padding="12,0" Margin="6,2" FocusVisualStyle="{x:Null}">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Glyph="&#xE897;" FontSize="20" Style="{StaticResource SolidNavIconStyle}"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- 主内容区域 -->
            <Grid Background="{DynamicResource SteamContentGlowBrush}">
                <ui:TransitioningContentControl x:Name="ContentTransition"
                                                 Transition="RightReplace"
                                                 Background="{x:Null}"/>
                <!--
                    Tool sub-pages must stay interactive while background work is
                    running. Hosting them outside TransitioningContentControl avoids
                    its outgoing visual snapshot intercepting input after a nested
                    navigation interrupts the transition.
                -->
                <ContentControl x:Name="StorageManagerHost"
                                Panel.ZIndex="2"
                                Visibility="Collapsed"
                                Background="{DynamicResource SteamContentBrush}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>
            </Grid>
        </ui:NavigationView>

            <!-- 侧边栏使用柔和投影分层，不再绘制硬质竖向描边。 -->
            <Border x:Name="NavigationPaneShadow"
                    Width="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Panel.ZIndex="8"
                    Background="#000000"
                    Opacity="0.14"
                    IsHitTestVisible="False"
                    Effect="{StaticResource SteamPaneShadowEffect}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NavigationPaneShadowTransform" X="213"/>
                </Border.RenderTransform>
            </Border>

            <!-- 收起状态的底部选中指示条；展开状态沿用 NavigationView 的竖向指示条。 -->
            <Canvas x:Name="CollapsedSelectionLayer"
                    IsHitTestVisible="False"
                    Panel.ZIndex="15">
                <Border x:Name="CollapsedSelectionIndicator"
                        Width="18" Height="3"
                        Background="{DynamicResource SteamAccentBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed"/>
            </Canvas>

            <!-- 中部收起按钮：收起后仅保留图标，按钮本身跟随面板边缘过渡。 -->
            <Button x:Name="PaneToggleButton"
                    Width="34" Height="36"
                    Margin="197,0,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Panel.ZIndex="9"
                    Background="{DynamicResource SteamSidebarBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource SteamTextTertiaryBrush}"
                    Cursor="Hand"
                    Focusable="False"
                    AutomationProperties.Name="切换侧边栏"
                    ToolTip="收起侧边栏"
                    Click="PaneToggleButton_Click">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="PaneToggleTransform" X="0"/>
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PaneToggleBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,7,7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PaneToggleBackground" Property="Background" Value="#243747"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <!-- 展开时箭头指向左侧（收起），收起后切换为向右（展开）。 -->
                <ui:FontIcon x:Name="PaneToggleGlyph" Glyph="&#xE76B;" FontSize="18"
                             Foreground="{DynamicResource SteamTextTertiaryBrush}">
                    <ui:FontIcon.RenderTransform>
                        <TranslateTransform X="3"/>
                    </ui:FontIcon.RenderTransform>
                </ui:FontIcon>
            </Button>
        </Grid>

        <!-- 顶栏账号下拉浮层。 -->
        <Canvas Grid.RowSpan="2" x:Name="OverlayCanvas" Panel.ZIndex="100" IsHitTestVisible="True">
            <Border x:Name="AccountSubmenu" Canvas.Left="0" Canvas.Top="0"
                    Width="260" Padding="4" CornerRadius="3" Panel.ZIndex="4"
                    Background="{DynamicResource SteamSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="Collapsed"
                    MouseEnter="AccountSubmenu_MouseEnter"
                    MouseLeave="AccountSubmenu_MouseLeave">
                <Border.Resources>
                    <Style x:Key="AccountDeleteButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="30"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="2,0,1,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#7F8A96"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="DeleteBackground" CornerRadius="3"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DeleteBackground" Property="Background" Value="#3A252A"/>
                                            <Setter Property="Foreground" Value="#FF7B72"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="DeleteBackground" Property="Background" Value="#543038"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="NewAccountButtonStyle" TargetType="Button">
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource SteamAccentBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NewAccountBackground" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NewAccountBackground" Property="Background" Value="#243447"/>
                                            <Setter Property="Foreground" Value="#61B8EA"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="NewAccountBackground" Property="Background" Value="#2B3E54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="AccountScrollViewer" Grid.Row="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl x:Name="AccountList" Margin="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border x:Name="Divider" Height="1" Margin="6,2"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                Visibility="Collapsed"/>
                                        <Grid x:Name="AccountItemRow" Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccountItemBorder" Grid.Column="0" Padding="8,6" CornerRadius="4"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonDown="AccountItem_Click"
                                                    MouseEnter="AccountMenuItem_MouseEnter"
                                                    MouseLeave="AccountMenuItem_MouseLeave">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" Margin="0,0,8,0" CornerRadius="3"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            VerticalAlignment="Center">
                                                        <Grid>
                                                            <ui:FontIcon Glyph="&#xE77B;" FontSize="15"
                                                                         Foreground="{DynamicResource SteamTextTertiaryBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Width="32" Height="32" Stretch="UniformToFill"
                                                                   Source="{Binding AvatarPath}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PersonaName}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding PersonaName}"/>
                                                        <TextBlock Text="{Binding AccountName}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding AccountName}"/>
                                                    </StackPanel>
                                                    <ui:FontIcon x:Name="CurrentAccountCheck" Grid.Column="2"
                                                                 Glyph="&#xE73E;" FontSize="13" Margin="6,0,2,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource SteamGreenBrush}"
                                                                 Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Column="1" Style="{StaticResource AccountDeleteButtonStyle}"
                                                    Tag="{Binding}" Click="DeleteAccountButton_Click"
                                                    ToolTip="删除本地账号记录">
                                                <ui:FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter TargetName="Divider" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="AccountItemRow" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="AccountItemBorder" Property="Background" Value="#243447"/>
                                            <Setter TargetName="CurrentAccountCheck" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="1" Height="1" Margin="6,4,6,2"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                    <Button Grid.Row="2" Style="{StaticResource NewAccountButtonStyle}"
                            Click="NewSteamAccountButton_Click"
                            ToolTip="退出当前 Steam，并打开登录界面">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE710;" FontSize="14" Margin="1,0,10,0"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="登录新账号" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Canvas>

        <!-- OpenSteamTool 安装/更新遮罩层 -->
        <Grid Grid.RowSpan="2" x:Name="KernelOverlayGrid" Panel.ZIndex="210"
              Visibility="Collapsed" Background="#80000000" IsHitTestVisible="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="400" MinHeight="150" CornerRadius="3"
                    Background="{DynamicResource SteamSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Margin="24,20">
                    <TextBlock x:Name="KernelOverlayStatus" FontSize="14" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="KernelOverlayHint" FontSize="11" TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" Visibility="Collapsed"
                               Text="若下载过慢可尝试开启代理或 VPN"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="KernelOverlayProgressBar" Minimum="0" Maximum="100" Value="0"
                                     Height="6" Visibility="Collapsed"/>
                        <TextBlock x:Name="KernelOverlayPercent" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="10,0,0,0" Visibility="Collapsed" Text="0%"/>
                    </Grid>
                    <ui:ProgressRing x:Name="KernelOverlayRing" IsActive="True" Width="28" Height="28"
                                     Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <Button x:Name="KernelCancelButton" Content="取消" Margin="0,14,0,0"
                            Padding="12,6" FontSize="13" HorizontalAlignment="Center"
                            Click="KernelCancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DLC 查询遮罩层 -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="200"
              Visibility="{Binding IsDlcQueryOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#80000000" IsHitTestVisible="True">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="320" MinHeight="120" CornerRadius="3"
                    Background="{DynamicResource SteamSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,16">
                    <ui:ProgressRing IsActive="True" Width="32" Height="32"
                                     HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DlcQueryOverlayText}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,12,0,0"
                               FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               TextAlignment="Center"/>
                    <Button Content="取消" Margin="0,14,0,0"
                            Padding="12,6" FontSize="13" HorizontalAlignment="Center"
                            Command="{Binding CancelDlcQueryCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
