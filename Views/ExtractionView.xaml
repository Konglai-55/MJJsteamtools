<UserControl x:Class="SteamLuaManager.Views.ExtractionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,24">

            <TextBlock Text="Lua 提取" Style="{StaticResource SteamPageTitleStyle}" Margin="0,0,0,4"/>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="输入游戏 AppID，从 Steam 配置中获取仓库密钥并生成 Lua 入库清单"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="需账号拥有正版游戏且下载后启动过游戏"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 本地所有 Steam 账号与游戏索引 -->
            <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="10"
                    Padding="16" Margin="0,0,0,14"
                    Effect="{StaticResource SteamSectionShadowEffect}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{DynamicResource SteamAccentBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="账号游戏索引" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="扫描 Steam userdata 与本地库，按账号快速定位并提取 Lua"
                                       FontSize="12" Margin="24,3,0,0"
                                       Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" HorizontalAlignment="Right"
                                Command="{Binding ScanLibraryCommand}"
                                Style="{StaticResource SteamSecondaryButtonStyle}" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE72C;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="扫描账号与游戏"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,14,0,12">
                        <Border Background="{DynamicResource SteamCardBrush}" CornerRadius="7" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="账号" FontSize="11" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding AccountCount}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SteamCardBrush}" CornerRadius="7" Padding="12" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="不同游戏" FontSize="11" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding GameCount}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource SteamCardBrush}" CornerRadius="7" Padding="12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="当前结果" FontSize="11" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ResultCount}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource SteamAccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <TextBox x:Name="LibrarySearchBox" Height="34" Padding="10,5"
                                 TextChanged="LibrarySearchBox_TextChanged"
                                 ToolTip="搜索游戏名、AppID 或账号">
                            <TextBox.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Background" Value="{DynamicResource SteamCardBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="搜索账号、游戏名或 AppID" IsHitTestVisible="False"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=LibrarySearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource SteamCardBrush}" CornerRadius="8" Padding="4">
                        <Grid>
                            <TextBlock Text="{Binding LibraryScanStatus}" Margin="10,10" FontSize="12"
                                       Foreground="{DynamicResource SteamTextSecondaryBrush}"
                                       Visibility="{Binding AccountGames.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                            <ScrollViewer MaxHeight="286" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AccountGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,9" Margin="0,1" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="64" Height="38" CornerRadius="6" Background="#1F4864" VerticalAlignment="Center"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}"
                                                                   Stretch="UniformToFill" Opacity="0.92"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <Border Background="#660E1A28"/>
                                                            <TextBlock Text="{Binding StateGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SteamAccentBrush}" FontSize="12" FontWeight="Bold"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AppIdText, StringFormat=AppID: {0}}" FontSize="11"
                                                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding AccountName}" FontSize="12" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding StateText}" FontSize="11" HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource SteamAccentBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Tag="{Binding}" Click="ExtractIndexedGame_Click"
                                                            Style="{StaticResource SteamPrimaryButtonStyle}" Padding="10,5"
                                                            ToolTip="使用此账号的本地配置提取 Lua">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:FontIcon Glyph="&#xE898;" FontSize="13" Margin="0,0,5,0"/>
                                                            <TextBlock Text="提取 Lua"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- AppID 输入 + 选项 -->
            <Border Style="{StaticResource SteamToolbarBorderStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="AppID:" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <Grid Grid.Column="1" VerticalAlignment="Stretch">
                            <TextBlock Text="输入游戏 Steam ID"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=AppIdBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="AppIdBox"
                                     Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Height="36" FontSize="14"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Stretch"
                                     Background="Transparent"
                                     IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInvertConverter}}"/>
                        </Grid>

                        <Button Grid.Column="2" Command="{Binding StartExtractionCommand}"
                                Style="{StaticResource SteamPrimaryButtonStyle}" Margin="8,0,4,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:FontIcon Glyph="&#xE768;" FontSize="14" Margin="0,0,6,0"
                                             Visibility="{Binding IsRunning, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                <ui:FontIcon Glyph="&#xE71A;" FontSize="14" Margin="0,0,6,0"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding IsRunning, Converter={StaticResource BoolToRunStopConverter}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Command="{Binding ClearLogCommand}"
                                Style="{StaticResource SteamSecondaryButtonStyle}" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:FontIcon Glyph="&#xE74D;" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="清除日志" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,32,0">
                            <CheckBox Content="固定游戏版本" IsChecked="{Binding PinManifest}"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      FontSize="13"/>
                            <TextBlock Text="获取游戏Depots的最新清单ID并写入Lua"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="11" Margin="24,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <CheckBox Content="提取游戏成就文件" IsChecked="{Binding ExtractAchievements}"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      FontSize="13"/>
                            <TextBlock Text="从Steam缓存提取游戏的成就文件"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       FontSize="11" Margin="24,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 命令行式详细日志默认收起，需要时再展开。 -->
            <Expander IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE756;" FontSize="14" Margin="0,0,8,0"
                                     Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                        <TextBlock Text="运行日志" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                        <TextBlock Text="{Binding LogLines.Count, StringFormat={}{0} 条}"
                                   FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    </StackPanel>
                </Expander.Header>
                <Border Style="{StaticResource SteamCardBorderStyle}" Padding="0" Height="220" Margin="0,6,0,0">
                    <Grid>
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Margin="16"
                                      PreviewMouseWheel="LogScrollViewer_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding LogLines}"
                                          ItemContainerStyle="{StaticResource SteamAnimatedItemContainerStyle}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button x:Name="CopyLogButton" Content="复制日志"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,8,8,0" Padding="8,4" FontSize="12"
                                Click="CopyLogButton_Click" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
