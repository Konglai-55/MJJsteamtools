<Window x:Class="SteamLuaManager.Views.ManifestCacheWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="清单缓存管理" Width="900" Height="660" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SteamBackgroundBrush}"
        Foreground="{DynamicResource SteamTextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="清单缓存管理" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{DynamicResource SteamTextSecondaryBrush}"
                       Text="收集本地清单，或通过 Steam 账号获取已拥有游戏的清单。缓存不修改 Steam 文件，也不自动入库游戏。"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,14">
            <Button Content="扫描 Steam 缓存" Click="Scan_Click" Margin="0,0,8,8" Padding="14,10"/>
            <Button Content="导入清单文件" Click="Import_Click" Margin="0,0,8,8" Padding="14,10"/>
            <Button Content="打开缓存目录" Click="OpenCache_Click" Margin="0,0,8,8" Padding="14,10"/>
        </WrapPanel>
        <Border Grid.Row="2" Padding="16" Margin="0,0,0,16" CornerRadius="6"
                Background="{DynamicResource SteamSurfaceBrush}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="获取官方下载器" Click="Official_Click" Padding="10,6"/>
                    <TextBlock Text="从 Steam 获取清单" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DownloaderPath" IsReadOnly="True" MinHeight="34" VerticalContentAlignment="Center"
                             ToolTip="选择从官方项目下载的 DepotDownloader.exe"/>
                    <Button Grid.Column="1" Content="选择下载器…" Click="SelectDownloader_Click" Margin="8,0,0,0" Padding="12,8"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="游戏 AppID" Margin="0,0,0,6"/><TextBox x:Name="AppIdInput" MinHeight="34"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Steam 登录账号名（不是昵称）" Margin="0,0,0,6"/><TextBox x:Name="UsernameInput" MinHeight="34"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="FetchButton" Content="获取清单" Click="Fetch_Click" Padding="12,9"/>
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Margin="8,0,0,0" Padding="12,9"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="密码和 Steam Guard 验证仅在下载器窗口中输入；MST 不保存账号密码。"
                           Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
            </StackPanel>
        </Border>
        <ListView x:Name="ManifestList" Grid.Row="3" Background="{DynamicResource SteamSurfaceBrush}"
                  Foreground="{DynamicResource SteamTextPrimaryBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View><GridView>
                <GridViewColumn Header="文件" Width="250" DisplayMemberBinding="{Binding Name}"/>
                <GridViewColumn Header="来源" Width="170" DisplayMemberBinding="{Binding Source}"/>
                <GridViewColumn Header="大小" Width="85" DisplayMemberBinding="{Binding SizeText}"/>
                <GridViewColumn Header="SHA256（完整性记录）" Width="240" DisplayMemberBinding="{Binding Sha256}"/>
            </GridView></ListView.View>
        </ListView>
        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,14,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
    </Grid>
</Window>
