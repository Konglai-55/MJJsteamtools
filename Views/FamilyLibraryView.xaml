<UserControl x:Class="SteamLuaManager.Views.FamilyLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:controls="clr-namespace:SteamLuaManager.Controls"
             Loaded="FamilyLibraryView_Loaded"
             Unloaded="FamilyLibraryView_Unloaded"
             Background="{DynamicResource SteamContentBrush}">
    <Grid Margin="26,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Steam 家庭库" Style="{StaticResource SteamPageTitleStyle}"/>
                <TextBlock Text="整理 Steam 家庭全部成员的付费可共享游戏，并标明实际拥有者"
                           Style="{StaticResource SteamPageSubtitleStyle}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SteamSecondaryButtonStyle}" Click="ConnectSteamFamily_Click"
                        ToolTip="登录 Steam Store 并读取真实家庭成员与共享库">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE77B;" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="连接 Steam"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SteamSecondaryButtonStyle}" Click="OpenFamilyManagement_Click"
                        Margin="8,0,0,0" ToolTip="在 Steam 官方页面管理成员身份和家长控制">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE716;" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="Steam 家庭管理"/>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Style="{StaticResource SteamPrimaryButtonStyle}"
                        Click="RefreshButton_Click" ToolTip="重新读取 Steam 家庭成员与共享库">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE72C;" FontSize="14" Margin="0,0,7,0"/>
                        <TextBlock Text="刷新"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="5" Padding="13,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12" Background="#243D53" VerticalAlignment="Top">
                    <ui:FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#68B8F3"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,18,0">
                    <TextBlock Text="真实 Steam 家庭数据" Foreground="{DynamicResource SteamTextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="成员、游戏名称和拥有者均来自 Steam 家庭接口；免费游戏、不支持共享的游戏和非游戏内容已在源头排除。"
                               Foreground="{DynamicResource SteamTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding DataScopeText}" Foreground="#78A7C8"
                           FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="家庭成员" Style="{StaticResource SteamSectionTitleStyle}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="286" Height="96" Margin="0,0,9,9" Padding="10"
                                        Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#172434"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                            <Grid>
                                                <ui:FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="#70869B"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="#1B4F73" CornerRadius="8" Padding="6,1">
                                                    <TextBlock Text="{Binding RoleText}" FontSize="9" Foreground="#8FD1FF"/>
                                                </Border>
                                                <TextBlock Text="{Binding PersonaName}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource SteamTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DetailText}" FontSize="10" Margin="0,4,0,0"
                                                       Foreground="#8EB2CE" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SteamId}"/>
                                            <TextBlock Text="{Binding SecondaryText}" FontSize="9"
                                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding TertiaryText}" FontSize="9"
                                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="家庭游戏" Style="{StaticResource SteamSectionTitleStyle}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding GameCountText}" Foreground="{DynamicResource SteamTextTertiaryBrush}"
                           FontSize="11" Margin="9,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <controls:SearchTextBox x:Name="SearchBox" Width="250" Height="34"
                                        Style="{StaticResource SteamSearchTextBoxStyle}"
                                        ToolTip="搜索家庭库游戏"
                                        AutomationProperties.Name="搜索家庭库游戏"
                                        TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="FilterBox" Width="150" Height="34" Margin="8,0,0,0" SelectedIndex="0"
                          SelectionChanged="FilterBox_SelectionChanged">
                    <ComboBoxItem Content="全部状态" Tag="All"/>
                    <ComboBoxItem Content="已安装" Tag="Installed"/>
                    <ComboBoxItem Content="支持家庭共享" Tag="Shareable"/>
                    <ComboBoxItem Content="本机运行中" Tag="Running"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="5">
                <Grid>
                    <ListView x:Name="GameList" ItemsSource="{Binding VisibleGames}" Background="Transparent"
                              BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#26384B"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="92" Margin="12,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="142"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="112"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="128" Height="72" CornerRadius="3" Background="#243244"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
                                        <Grid>
                                            <ui:FontIcon Glyph="&#xE7FC;" FontSize="24" Foreground="#50687E"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding AppIdText}" FontSize="10" Foreground="#8FA5B9"/>
                                            <TextBlock Text=" · " FontSize="10" Foreground="#62778A"/>
                                            <TextBlock Text="{Binding InstallStatusText}" FontSize="10" Foreground="#8FA5B9"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PlaytimeText}" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                                                ToolTip="{Binding OwnerEvidence}">
                                        <TextBlock Text="游戏拥有者" FontSize="9" Foreground="#6F879D"/>
                                        <TextBlock Text="{Binding OwnerDisplay}" FontSize="12" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="由 Steam 家庭接口确认" FontSize="9" Margin="0,3,0,0" Foreground="#678096"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="当前状态" FontSize="9" Foreground="#6F879D"/>
                                        <TextBlock Text="{Binding Availability}" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="#B8CBDD" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SteamPrimaryButtonStyle}" Padding="10,6"
                                                Tag="{Binding}" Click="ImportGame_Click" ToolTip="为该游戏生成或下载 Lua 入库清单">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:FontIcon Glyph="&#xE896;" FontSize="12" Margin="0,0,5,0"/>
                                                <TextBlock Text="一键入库" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SteamSecondaryButtonStyle}" Padding="10,4" Margin="0,6,0,0"
                                                Tag="{Binding}" Click="OpenLibrary_Click" ToolTip="在 Steam 游戏库中打开详情">
                                            <TextBlock Text="从库里打开" FontSize="10"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ui:FontIcon Glyph="&#xE8F1;" FontSize="30" Foreground="#536A80" HorizontalAlignment="Center"/>
                        <TextBlock Text="没有符合条件的游戏" Foreground="#8398AA" Margin="0,10,0,0"/>
                    </StackPanel>

                    <Border Background="#C016202D" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing IsActive="True" Width="34" Height="34"/>
                            <TextBlock Text="正在读取 Steam 家庭成员与共享库…" Foreground="#AFC4D8" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#F016202D"
                            Visibility="{Binding RequiresConnection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="27" Background="#23384C" HorizontalAlignment="Center">
                                <ui:FontIcon Glyph="&#xE716;" FontSize="24" Foreground="#67B8F2"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="连接真实 Steam 家庭库" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SteamTextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                            <TextBlock Text="登录后将展示完整家庭成员，以及家庭中所有付费且支持家庭共享的游戏。不会再使用本机游玩记录冒充家庭库。"
                                       TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource SteamTextSecondaryBrush}" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource SteamPrimaryButtonStyle}" Click="ConnectSteamFamily_Click"
                                    HorizontalAlignment="Center" Margin="0,18,0,0" Padding="20,8">
                                <StackPanel Orientation="Horizontal">
                                    <ui:FontIcon Glyph="&#xE77B;" FontSize="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="登录并读取家庭库"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="仅保存独立 WebView 登录状态；短期访问令牌只保存在本次运行内存中"
                                       FontSize="10" Foreground="#677E92" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
