<UserControl x:Class="SteamLuaManager.Views.SteamStorageManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             Loaded="UserControl_Loaded"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Width="42" Height="38" Padding="0"
                    Margin="0,0,12,0" ToolTip="返回实用工具" Click="BackButton_Click">
                <ui:FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Steam 存储空间" Style="{StaticResource SteamPageTitleStyle}"/>
                <TextBlock Text="选择磁盘，按游戏汇总本体、创意工坊、着色器与其他 Steam 数据。"
                           Margin="0,3,0,0" FontSize="12"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
            </StackPanel>
            <Button x:Name="ScanButton" Grid.Column="2" Content="重新扫描"
                    Style="{StaticResource SteamPrimaryButtonStyle}" MinWidth="108"
                    Padding="16,8" VerticalAlignment="Center" Click="ScanButton_Click"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="14,10"
                Background="#24282F" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:FontIcon Glyph="&#xEDA2;" FontSize="20" Margin="0,0,12,0"
                             Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                <ComboBox x:Name="DriveSelector" Grid.Column="1" Height="34"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="DriveSelector_SelectionChanged"/>
                <TextBlock x:Name="DriveLibraryCountText" Grid.Column="2"
                           Margin="15,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                <TextBlock x:Name="DriveCapacityText" Grid.Column="3"
                           VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="10,17,10,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectedLibraryText" Text="—" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                <Button x:Name="OpenDriveMenuButton" Grid.Column="1" Width="38" Height="30"
                        Padding="0" Margin="8,-6,0,4" Content="•••"
                        Click="OpenDriveMenuButton_Click"/>
            </Grid>
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GameSegmentColumn" Width="0"/>
                    <ColumnDefinition x:Name="WorkshopSegmentColumn" Width="0"/>
                    <ColumnDefinition x:Name="ShaderSegmentColumn" Width="0"/>
                    <ColumnDefinition x:Name="OtherSteamSegmentColumn" Width="0"/>
                    <ColumnDefinition x:Name="OtherUsedSegmentColumn" Width="0"/>
                    <ColumnDefinition x:Name="FreeSegmentColumn" Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#2E9BEA"/>
                <Border Grid.Column="1" Background="#65C763"/>
                <Border Grid.Column="2" Background="#9B72D7"/>
                <Border Grid.Column="3" Background="#F0B83F"/>
                <Border Grid.Column="4" Background="#384454"/>
                <Border Grid.Column="5" Background="#5B6573"/>
            </Grid>
            <WrapPanel Grid.Row="2" Margin="0,9,0,0">
                <Ellipse Width="8" Height="8" Fill="#2E9BEA" Margin="0,0,5,0"/>
                <TextBlock x:Name="GameLegendText" Margin="0,0,14,0" FontSize="10"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                <Ellipse Width="8" Height="8" Fill="#65C763" Margin="0,0,5,0"/>
                <TextBlock x:Name="WorkshopLegendText" Margin="0,0,14,0" FontSize="10"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                <Ellipse Width="8" Height="8" Fill="#9B72D7" Margin="0,0,5,0"/>
                <TextBlock x:Name="ShaderLegendText" Margin="0,0,14,0" FontSize="10"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                <Ellipse Width="8" Height="8" Fill="#F0B83F" Margin="0,0,5,0"/>
                <TextBlock x:Name="OtherSteamLegendText" Margin="0,0,14,0" FontSize="10"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                <Ellipse Width="8" Height="8" Fill="#384454" Margin="0,0,5,0"/>
                <TextBlock x:Name="OtherUsedLegendText" Margin="0,0,14,0" FontSize="10"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                <Ellipse Width="8" Height="8" Fill="#5B6573" Margin="0,0,5,0"/>
                <TextBlock x:Name="FreeLegendText" FontSize="10"
                           Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,3,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ItemCountText" Text="项目 0" VerticalAlignment="Center"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
            <Border Grid.Column="1" Height="1" Margin="12,0" VerticalAlignment="Center"
                    Background="{DynamicResource SteamDividerBrush}"/>
            <ComboBox x:Name="FilterComboBox" Grid.Column="2" Width="135" Height="32"
                      Margin="0,0,8,0" SelectionChanged="FilterOrSort_SelectionChanged">
                <ComboBoxItem Content="全部内容" Tag="all" IsSelected="True"/>
                <ComboBoxItem Content="游戏本体" Tag="games"/>
                <ComboBoxItem Content="创意工坊" Tag="workshop"/>
                <ComboBoxItem Content="着色器" Tag="shader"/>
                <ComboBoxItem Content="其他 Steam 数据" Tag="other"/>
            </ComboBox>
            <ComboBox x:Name="SortComboBox" Grid.Column="3" Width="145" Height="32"
                      SelectionChanged="FilterOrSort_SelectionChanged">
                <ComboBoxItem Content="按占用空间大小" Tag="size" IsSelected="True"/>
                <ComboBoxItem Content="按名称" Tag="name"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="11,8" Margin="0,0,0,8" Background="#172738"
                    BorderBrush="#29445A" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon x:Name="ScanStatusIcon" Glyph="&#xE73E;" FontSize="13"
                                 Margin="0,1,8,0" Foreground="#79C47B"/>
                    <TextBlock x:Name="ScanStatusText" Grid.Column="1" Text="正在读取磁盘…"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                    <ProgressBar x:Name="ScanProgressBar" Grid.Column="2" Height="4"
                                 Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ListView x:Name="ContentItemsList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,8,7"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="116" Height="66" Background="{DynamicResource SteamShellBrush}" CornerRadius="3"
                                            HorizontalAlignment="Left" ClipToBounds="True">
                                        <Grid>
                                            <ui:FontIcon Glyph="&#xE7FC;" FontSize="22"
                                                         Foreground="#526274"/>
                                            <Image Source="{Binding CoverImagePath, Mode=OneWay}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding IdentityText, Mode=OneWay}" FontSize="10"
                                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="  ·  " FontSize="10"
                                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding ContentSummaryText, Mode=OneWay}" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#8EA6BA"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PrimaryPath, Mode=OneWay}"
                                                   ToolTip="{Binding PrimaryPath, Mode=OneWay}"
                                                   Margin="0,5,0,0" FontSize="9" TextTrimming="CharacterEllipsis"
                                                   Foreground="#66849C"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalSizeText, Mode=OneWay}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                                    <Button Grid.Column="3" Content="管理" MinWidth="74" Padding="12,6"
                                            Margin="15,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource SteamPrimaryButtonStyle}"
                                            Tag="{Binding}" Click="ManageItemButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:FontIcon Glyph="&#xE838;" FontSize="34" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    <TextBlock Text="这个磁盘中没有符合筛选条件的 Steam 内容" Margin="0,10,0,0"
                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
