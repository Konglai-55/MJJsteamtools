<UserControl x:Class="SteamLuaManager.Views.UtilityToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             Background="Transparent"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="0"
                  Background="Transparent">
        <StackPanel Margin="28,22,28,28">
            <TextBlock Text="实用工具"
                       Style="{StaticResource SteamPageTitleStyle}"/>
            <TextBlock Text="集中处理 Steam 常见故障，减少在客户端设置中反复查找。"
                       Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource SteamTextSecondaryBrush}"/>

            <TextBlock Text="Steam 维护"
                       Margin="0,26,0,10"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SteamTextPrimaryBrush}"/>

            <Border Background="{DynamicResource SteamSurfaceBrush}"
                    BorderBrush="{DynamicResource SteamDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SteamHoverBrush}"
                            BorderBrush="{DynamicResource SteamDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ui:FontIcon Glyph="&#xE896;"
                                     FontSize="18"
                                     Foreground="{DynamicResource SteamAccentBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,18,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="清除下载缓存"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                        <TextBlock Text="解决游戏下载停滞、更新卡住或下载后无法启动等问题。"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:FontIcon Glyph="&#xE73E;" FontSize="11"
                                         Margin="0,0,6,0"
                                         Foreground="#79C47B"/>
                            <TextBlock Text="不会删除已安装游戏"
                                       FontSize="11"
                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                            <TextBlock Text="  ·  清理后需要重新登录 Steam"
                                       FontSize="11"
                                       Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="ClearDownloadCacheButton"
                            Grid.Column="2"
                            Content="清除缓存"
                            Style="{StaticResource SteamPrimaryButtonStyle}"
                            MinWidth="106"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Click="ClearDownloadCacheButton_Click"/>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Background="{DynamicResource SteamSurfaceBrush}"
                    BorderBrush="{DynamicResource SteamDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SteamHoverBrush}"
                            BorderBrush="{DynamicResource SteamDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ui:FontIcon Glyph="&#xE958;" FontSize="18"
                                     Foreground="{DynamicResource SteamAccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="Steam 空间管家"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                        <TextBlock Text="统计所有游戏库，查看游戏、创意工坊、缓存和下载残留占用。"
                                   Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                        <TextBlock Text="支持多库目录 · 分类扫描 · 安全清理"
                                   Margin="0,8,0,0" FontSize="11"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="打开空间管家"
                            Style="{StaticResource SteamPrimaryButtonStyle}"
                            MinWidth="120"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Click="OpenStorageManagerButton_Click"/>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Background="{DynamicResource SteamSurfaceBrush}"
                    BorderBrush="{DynamicResource SteamDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SteamHoverBrush}"
                            BorderBrush="{DynamicResource SteamDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ui:FontIcon Glyph="&#xE753;" FontSize="18"
                                     Foreground="{DynamicResource SteamAccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="Steam 云同步急救"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                        <TextBlock Text="读取 Steam 云日志，定位反复报错的游戏、冲突文件与风险等级。"
                                   Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                        <TextBlock Text="官方日志诊断 · 修复前自动备份 · 不直接删除云端文件"
                                   Margin="0,8,0,0" FontSize="11"
                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="打开云同步急救"
                            Style="{StaticResource SteamPrimaryButtonStyle}"
                            MinWidth="128"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Click="OpenCloudSyncRescueButton_Click"/>
                </Grid>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="13,10"
                    Background="#172738"
                    BorderBrush="#29445A"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xE946;"
                                 FontSize="14"
                                 Margin="0,1,9,0"
                                 Foreground="#69A9D0"/>
                    <TextBlock Text="确认后将安全关闭 Steam，再由 Steam 自己清理缓存并重新启动；本工具不会自行删除 Steam 文件。"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0" Padding="18,16" CornerRadius="6"
                    Background="{DynamicResource SteamSurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="清单缓存管理" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SteamTextPrimaryBrush}"/>
                        <TextBlock Text="扫描 Steam 本地清单、导入清单文件，或从账号获取已拥有游戏的清单。"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="管理清单缓存" Padding="16,10"
                            VerticalAlignment="Center" Click="OpenManifestCache_Click"/>
                </Grid>
            </Border>

            <TextBlock x:Name="ActionStatusText"
                       Margin="2,12,0,0"
                       FontSize="12"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
