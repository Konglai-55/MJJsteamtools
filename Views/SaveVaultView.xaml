<UserControl x:Class="SteamLuaManager.Views.SaveVaultView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:controls="clr-namespace:SteamLuaManager.Controls"
        Background="{DynamicResource SteamContentBrush}"
        Foreground="{DynamicResource SteamTextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="VaultMetricCard" TargetType="Border">
            <Setter Property="Background" Value="#16202D"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="VaultListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="controls:MotionBehavior.IsEntranceEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VaultToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="60" Height="30">
                            <Border x:Name="Track" CornerRadius="15" Background="#111B27"/>
                            <Ellipse x:Name="Thumb" Width="24" Height="24"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" Fill="#AAAAAA"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SteamAccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#152333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid x:Name="OverviewPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="存档保险箱" Style="{StaticResource SteamPageTitleStyle}"/>
                    <TextBlock Text="自动找到游戏存档，一键备份；存档损坏或误覆盖时可以恢复旧版本"
                               FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开备份目录" Style="{StaticResource SteamSecondaryButtonStyle}"
                            Padding="12,7" Margin="0,0,8,0" Click="OpenBackupRoot_Click"/>
                    <Button Content="一键备份全部" Style="{StaticResource SteamPrimaryButtonStyle}"
                            Padding="13,7" Margin="0,0,8,0" Click="BackupAll_Click"/>
                    <Button Content="重新扫描" Style="{StaticResource SteamSecondaryButtonStyle}"
                            Padding="12,7" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,16">
                <Border Style="{StaticResource VaultMetricCard}">
                    <StackPanel>
                        <TextBlock Text="可以备份的游戏" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        <TextBlock x:Name="DetectedGamesText" Text="0" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource VaultMetricCard}">
                    <StackPanel>
                        <TextBlock Text="找到的存档文件" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        <TextBlock x:Name="SaveFilesText" Text="0" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource VaultMetricCard}">
                    <StackPanel>
                        <TextBlock Text="可恢复的备份" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        <TextBlock x:Name="SnapshotCountText" Text="0" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource VaultMetricCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="存档总大小" FontSize="11" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        <TextBlock x:Name="SaveSizeText" Text="0 B" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <controls:SearchTextBox x:Name="SearchBox" Width="260" Height="34"
                                            Style="{StaticResource SteamSearchTextBoxStyle}"
                                            ToolTip="搜索游戏名称或 AppID"
                                            AutomationProperties.Name="搜索游戏名称或 AppID"
                                            TextChanged="SearchBox_TextChanged"/>
                    <ComboBox x:Name="FilterCombo" Width="122" Height="34" Margin="8,0,0,0"
                              SelectedIndex="0" SelectionChanged="FilterCombo_SelectionChanged">
                        <ComboBoxItem Content="可以备份"/>
                        <ComboBoxItem Content="全部游戏"/>
                        <ComboBoxItem Content="已有备份"/>
                        <ComboBoxItem Content="未找到存档"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:ProgressRing x:Name="ScanProgressRing" Width="18" Height="18" IsActive="False"
                                     Visibility="Collapsed" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ScanStatusText" Text="等待扫描" FontSize="11"
                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource VaultListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="8" Margin="0,0,0,9" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Height="104" Background="#101925">
                                        <ui:FontIcon Glyph="&#xE8B7;" FontSize="30" Foreground="#425263"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageConverter}}"
                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="15,11,14,10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SteamTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="#173D30" CornerRadius="4" Padding="7,3" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{DynamicResource SteamGreenBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AppId, StringFormat=AppID: {0}}" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding LocationCountText}" FontSize="11" Foreground="#AEB9C4"/>
                                            <TextBlock Text="{Binding FileCount, StringFormat={}{0} 个文件}" FontSize="11" Margin="15,0,0,0" Foreground="#AEB9C4"/>
                                            <TextBlock Text="{Binding SizeText}" FontSize="11" Margin="15,0,0,0" Foreground="#AEB9C4"/>
                                            <TextBlock Text="{Binding LastModifiedText}" FontSize="11" Margin="15,0,0,0" Foreground="#7F90A1"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding OperationStatus}" FontSize="10" Margin="0,5,0,0"
                                                   Foreground="#78BCEB" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <Button Content="备份当前存档" Style="{StaticResource SteamPrimaryButtonStyle}"
                                                Padding="12,7" Margin="0,0,8,0" Tag="{Binding}"
                                                IsEnabled="{Binding HasSaveData}" Click="BackupGame_Click"/>
                                        <Button Content="查看详情" Style="{StaticResource SteamSecondaryButtonStyle}"
                                                Padding="12,7" Tag="{Binding}" Click="ViewGame_Click"/>
                                    </StackPanel>
                                    <ui:ProgressRing Grid.ColumnSpan="3" Width="28" Height="28" IsActive="True"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                                     IsHitTestVisible="False">
                                        <ui:ProgressRing.Style>
                                            <Style TargetType="ui:ProgressRing">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:ProgressRing.Style>
                                    </ui:ProgressRing>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <ui:FontIcon Glyph="&#xE8B7;" FontSize="34" Foreground="{DynamicResource SteamTextTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="当前筛选下没有存档记录" Margin="0,12,0,0" FontSize="12"
                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="DetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="← 返回存档保险箱" Style="{StaticResource SteamSecondaryButtonStyle}"
                        Padding="11,7" Click="BackToOverview_Click"/>
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="{Binding GameName}" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppId, StringFormat=AppID: {0}}" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    <TextBlock Text="这里会把下方所有存档文件夹一起备份，不需要逐个选择文件"
                               FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource SteamTextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="打开备份目录" Style="{StaticResource SteamSecondaryButtonStyle}"
                            Padding="12,7" Margin="0,0,8,0" Click="OpenSelectedBackupFolder_Click"/>
                    <Button Content="备份当前存档" Style="{StaticResource SteamPrimaryButtonStyle}"
                            Padding="13,7" Click="BackupSelected_Click"/>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,16">
                <Border Style="{StaticResource VaultMetricCard}"><StackPanel><TextBlock Text="找到的文件夹" FontSize="11" Foreground="#8090A0"/><TextBlock Text="{Binding LocationCountText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource VaultMetricCard}"><StackPanel><TextBlock Text="包含的文件" FontSize="11" Foreground="#8090A0"/><TextBlock Text="{Binding FileCount}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource VaultMetricCard}"><StackPanel><TextBlock Text="存档大小" FontSize="11" Foreground="#8090A0"/><TextBlock Text="{Binding SizeText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource VaultMetricCard}" Margin="0"><StackPanel><TextBlock Text="可恢复备份" FontSize="11" Foreground="#8090A0"/><TextBlock Text="{Binding BackupCountText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            </UniformGrid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,18">
                    <Border Background="{DynamicResource SteamShellBrush}" CornerRadius="7" Padding="13,11" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="退出游戏后自动备份" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock x:Name="VaultAutoSaveBackupStatusText"
                                           Text="已开启 · MJJST 运行时，游戏退出且存档有变化便自动创建快照"
                                           FontSize="10" Margin="0,4,0,0" Foreground="#8292A2"/>
                            </StackPanel>
                            <ToggleButton x:Name="VaultAutoSaveBackupToggle" Grid.Column="1"
                                          Style="{StaticResource VaultToggleStyle}"
                                          VerticalAlignment="Center" Margin="16,0,0,0"
                                          ToolTip="只控制当前游戏；关闭后仍可手动备份"
                                          AutomationProperties.Name="退出游戏后自动备份当前游戏存档"
                                          Click="VaultAutoSaveBackupToggle_Click"/>
                        </Grid>
                    </Border>
                    <Border Background="#173028" BorderBrush="#285044" BorderThickness="1"
                            CornerRadius="7" Padding="13,11" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="&#xE946;" FontSize="17" Foreground="{DynamicResource SteamGreenBrush}" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="怎么使用？" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="默认在游戏退出且存档有变化时自动备份；也可随时手动备份。需要回档时，在页面底部选择旧备份并恢复。"
                                           FontSize="10" Margin="0,3,0,0" Foreground="#9FB3AA"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="存档文件夹" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="程序已自动找到这些位置，备份时会全部处理"
                                       FontSize="10" Margin="0,3,0,0" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="ToggleLocationsButton" Content="查看存档文件夹"
                                Style="{StaticResource SteamSecondaryButtonStyle}" Padding="11,6"
                                HorizontalAlignment="Right" Click="ToggleLocations_Click"/>
                    </Grid>
                    <StackPanel x:Name="LocationListPanel" Visibility="Collapsed">
                        <ItemsControl ItemsSource="{Binding Locations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="7" Padding="13,10" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Source}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SummaryText}" FontSize="10" Margin="12,1,0,0" Foreground="#8292A2"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="10" Margin="0,5,0,0"
                                                           TextWrapping="Wrap" Foreground="#A8B5C1"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="打开文件夹" Style="{StaticResource SteamSecondaryButtonStyle}"
                                                    Padding="11,6" Margin="12,0,0,0" Tag="{Binding}" Click="OpenLocation_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid Margin="0,17,0,9">
                        <TextBlock Text="可读取的存档信息" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="能安全读取时，这里会显示角色、等级、章节和游戏时间等信息"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    </Grid>
                    <ItemsControl x:Name="StructuredSlotItems" Margin="0,0,-8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="7" Padding="13,11" Margin="0,0,8,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="#1A3B50" CornerRadius="4" Padding="7,3" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="#66C5FF"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding MetaText}" FontSize="10" Margin="0,5,0,0" Foreground="#8494A4"/>
                                        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,9,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#101A25" CornerRadius="4" Padding="7,5" Margin="0,0,6,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#738496"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="10" FontWeight="SemiBold"
                                                                       Margin="6,0,0,0" Foreground="#C5D1DC"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="UnparsedSaveNotice" Background="#172532" CornerRadius="7"
                            BorderBrush="#2B4255" BorderThickness="1" Padding="13,11" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:FontIcon Glyph="&#xE946;" FontSize="18" Foreground="#66C5FF"
                                         VerticalAlignment="Center" Margin="0,0,11,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="这个游戏的存档内容暂时无法直接读取" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="它使用了专用、压缩或加密格式，但备份和恢复功能仍然完全可用。"
                                           FontSize="10" Margin="0,3,0,0" Foreground="#8FA0B0"/>
                            </StackPanel>
                            <Button x:Name="ToggleRawFilesButton" Grid.Column="2" Content="查看原始文件"
                                    Style="{StaticResource SteamSecondaryButtonStyle}" Padding="11,6"
                                    Margin="12,0,0,0" Click="ToggleRawFiles_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="RawFilesPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="原始存档文件（高级信息）" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBlock Text="这些文件由游戏自动管理，不需要逐个操作；备份时会全部保存。"
                                   FontSize="10" Margin="0,0,0,8" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                        <ItemsControl x:Name="RawSlotItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141F2B" CornerRadius="5" Padding="11,8" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Source}" FontSize="9" Margin="0,3,0,0" Foreground="#748596"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding MetaText}" FontSize="9"
                                                       VerticalAlignment="Center" Foreground="#8091A2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock x:Name="NoSlotPreviewText" Text="没有找到可以预览的存档文件，但仍可正常备份和恢复"
                               HorizontalAlignment="Center" Margin="0,16,0,8" FontSize="11" Foreground="#7D8C9A"/>

                    <Grid Margin="0,17,0,9">
                        <TextBlock Text="可以恢复的旧版本" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="恢复前会自动创建当前状态回滚备份；不会删除快照中不存在的额外文件"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource SteamTextTertiaryBrush}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Snapshots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SteamSurfaceBrush}" CornerRadius="7" Padding="13,10" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CreatedText}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DetailText}" FontSize="10" Margin="0,4,0,0" Foreground="#8696A6"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="恢复此版本" Style="{StaticResource SteamSecondaryButtonStyle}"
                                                Padding="12,7" Tag="{Binding}" Click="RestoreSnapshot_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoSnapshotsText" Text="还没有备份，点击“备份当前存档”创建第一个可恢复版本"
                               HorizontalAlignment="Center" Margin="0,22,0,0" FontSize="11" Foreground="#7D8C9A"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
