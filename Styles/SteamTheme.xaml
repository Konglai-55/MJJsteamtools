<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SteamLuaManager.Controls"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">

    <!-- Calm graphite surfaces and one restrained blue action accent. -->
    <Color x:Key="SteamShellColor">#10151C</Color>
    <Color x:Key="SteamSidebarColor">#151C24</Color>
    <Color x:Key="SteamContentColor">#151D27</Color>
    <Color x:Key="SteamSurfaceColor">#1D2936</Color>
    <Color x:Key="SteamSurfaceRaisedColor">#243241</Color>
    <Color x:Key="SteamHoverColor">#2B3B4C</Color>
    <Color x:Key="SteamAccentColor">#57A5E9</Color>
    <Color x:Key="SteamAccentHoverColor">#70B7F4</Color>
    <Color x:Key="SteamAccentPressedColor">#3888CB</Color>
    <Color x:Key="SteamGreenColor">#61C8A5</Color>
    <Color x:Key="SteamDangerColor">#EE767E</Color>
    <Color x:Key="SteamTextPrimaryColor">#F3F7FA</Color>
    <Color x:Key="SteamTextSecondaryColor">#B5C1CE</Color>
    <Color x:Key="SteamTextTertiaryColor">#8B9AA8</Color>
    <Color x:Key="SteamDividerColor">#2E3C49</Color>

    <SolidColorBrush x:Key="SteamShellBrush" Color="{StaticResource SteamShellColor}"/>
    <SolidColorBrush x:Key="SteamSidebarBrush" Color="{StaticResource SteamSidebarColor}"/>
    <SolidColorBrush x:Key="SteamContentBrush" Color="{StaticResource SteamContentColor}"/>
    <SolidColorBrush x:Key="SteamSurfaceBrush" Color="{StaticResource SteamSurfaceColor}"/>
    <SolidColorBrush x:Key="SteamSurfaceRaisedBrush" Color="{StaticResource SteamSurfaceRaisedColor}"/>
    <SolidColorBrush x:Key="SteamHoverBrush" Color="{StaticResource SteamHoverColor}"/>
    <SolidColorBrush x:Key="SteamAccentBrush" Color="{StaticResource SteamAccentColor}"/>
    <SolidColorBrush x:Key="SteamAccentHoverBrush" Color="{StaticResource SteamAccentHoverColor}"/>
    <SolidColorBrush x:Key="SteamAccentPressedBrush" Color="{StaticResource SteamAccentPressedColor}"/>
    <SolidColorBrush x:Key="SteamPrimaryButtonBrush" Color="#2B76B5"/>
    <SolidColorBrush x:Key="SteamPrimaryButtonHoverBrush" Color="#3688C8"/>
    <SolidColorBrush x:Key="SteamPrimaryButtonPressedBrush" Color="#246597"/>
    <SolidColorBrush x:Key="SteamGreenBrush" Color="{StaticResource SteamGreenColor}"/>
    <SolidColorBrush x:Key="SteamDangerBrush" Color="{StaticResource SteamDangerColor}"/>
    <SolidColorBrush x:Key="SteamTextPrimaryBrush" Color="{StaticResource SteamTextPrimaryColor}"/>
    <SolidColorBrush x:Key="SteamTextSecondaryBrush" Color="{StaticResource SteamTextSecondaryColor}"/>
    <SolidColorBrush x:Key="SteamTextTertiaryBrush" Color="{StaticResource SteamTextTertiaryColor}"/>
    <SolidColorBrush x:Key="SteamDividerBrush" Color="{StaticResource SteamDividerColor}"/>
    <SolidColorBrush x:Key="SteamSearchFieldBrush" Color="#22272E"/>
    <SolidColorBrush x:Key="SteamSearchFieldHoverBrush" Color="#191E24"/>
    <SolidColorBrush x:Key="SteamSearchFieldBorderBrush" Color="#323B45"/>
    <SolidColorBrush x:Key="SteamSearchFieldHoverBorderBrush" Color="#48545F"/>

    <!-- One search language across library, discovery, trainer and management pages. -->
    <Style x:Key="SteamSearchFieldBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SteamSearchFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SteamSearchFieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SteamSearchFieldHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SteamSearchFieldHoverBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{StaticResource SteamSearchFieldHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SteamAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SteamSearchInnerTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SteamTextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SteamTextPrimaryBrush}"/>
        <Setter Property="Padding" Value="4,4,4,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SteamSearchSuggestStyle" TargetType="{x:Type ui:AutoSuggestBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SteamTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,4,4,4"/>
        <Setter Property="TextBoxStyle" Value="{StaticResource SteamSearchInnerTextBoxStyle}"/>
    </Style>

    <Style x:Key="SteamSearchTextBoxStyle" TargetType="{x:Type controls:SearchTextBox}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="{StaticResource SteamSearchFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SteamSearchFieldBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SteamTextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SteamTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SearchTextBox}">
                    <Border x:Name="SearchFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="17" Foreground="#929AA3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                                          Margin="0,0,2,0" VerticalAlignment="Center"
                                          Focusable="False" Background="Transparent"/>
                            <Button x:Name="ClearButton" Grid.Column="2" Style="{x:Null}"
                                    Width="28" Height="28" Padding="0" BorderThickness="0"
                                    Background="Transparent" Cursor="Hand" Focusable="False"
                                    ToolTip="清空搜索" AutomationProperties.Name="清空搜索"
                                    Command="{x:Static controls:SearchTextBox.ClearCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#A7AFB8" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ClearFrame" Background="Transparent" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClearFrame" Property="Background" Value="#303A44"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SearchFrame" Property="Background" Value="{StaticResource SteamSearchFieldHoverBrush}"/>
                            <Setter TargetName="SearchFrame" Property="BorderBrush" Value="{StaticResource SteamSearchFieldHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="SearchFrame" Property="Background" Value="{StaticResource SteamSearchFieldHoverBrush}"/>
                            <Setter TargetName="SearchFrame" Property="BorderBrush" Value="{StaticResource SteamAccentBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SearchFrame" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SteamSearchFilterButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource SteamSearchFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SteamSearchFieldBorderBrush}"/>
        <Setter Property="Foreground" Value="#A7AFB8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="FilterFrame" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FilterFrame" Property="Background" Value="{StaticResource SteamSearchFieldHoverBrush}"/>
                            <Setter TargetName="FilterFrame" Property="BorderBrush" Value="{StaticResource SteamSearchFieldHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FilterFrame" Property="BorderBrush" Value="{StaticResource SteamAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Background-free vector brand mark. Path.Fill controls its color. -->
    <GeometryGroup x:Key="BrandMarkGeometry" FillRule="Nonzero">
        <PathGeometry Figures="M200.58,100.29 C200.58,44.9 155.68,0 100.29,0 44.9,0 0,44.9 0,100.29 0,128.27 11.46,153.57 29.94,171.76 28.14,163.04 27.17,153.84 27.17,144.32 27.17,94.57 53.59,53.29 88.23,45.4 79.89,57.24 73.48,80.95 70.97,110.08 78.52,92.26 88.87,81.26 100.29,81.26 111.71,81.26 122.07,92.26 129.61,110.08 127.1,80.96 120.69,57.24 112.35,45.4 146.99,53.29 173.41,94.57 173.41,144.32 173.41,153.83 172.44,163.04 170.64,171.76 189.12,153.57 200.58,128.27 200.58,100.29 Z"/>
        <EllipseGeometry Center="100.29,145.68" RadiusX="22.93" RadiusY="22.93"/>
    </GeometryGroup>

    <!-- Override the Fluent resource names already used throughout the project. -->
    <Color x:Key="CardBackgroundFillColorDefault">#1D2936</Color>
    <Color x:Key="ControlFillColorDefault">#263543</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1D2936"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#334657"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#263543"/>
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#2B3C4C"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#3C5061"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2E3C49"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#151D27"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#10151C"/>
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#374A5A"/>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#57A5E9"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#57A5E9"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F3F7FA"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B5C1CE"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8B9AA8"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#647483"/>

    <Style x:Key="SteamPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SteamTextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="SteamPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SteamTextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SteamSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SteamTextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SteamCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SteamSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SteamDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="SteamInteractiveCardBorderStyle" TargetType="Border"
           BasedOn="{StaticResource SteamCardBorderStyle}">
        <Setter Property="controls:MotionBehavior.IsHoverLiftEnabled" Value="True"/>
    </Style>

    <Style x:Key="SteamHoverLiftStyle" TargetType="FrameworkElement">
        <Setter Property="controls:MotionBehavior.IsHoverLiftEnabled" Value="True"/>
    </Style>

    <Style x:Key="SteamAnimatedItemContainerStyle" TargetType="ContentPresenter">
        <Setter Property="controls:MotionBehavior.IsEntranceEnabled" Value="True"/>
    </Style>

    <Style x:Key="SteamToolbarBorderStyle" TargetType="Border" BasedOn="{StaticResource SteamCardBorderStyle}">
        <Setter Property="Background" Value="{StaticResource SteamSidebarBrush}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="SteamSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource SteamTextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SteamHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SteamDividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="controls:MotionBehavior.IsButtonFeedbackEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#344859"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#526A7B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#233341"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource SteamAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SteamPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SteamSecondaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SteamPrimaryButtonBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PrimaryButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PrimaryButtonBorder" Property="Background"
                                    Value="{StaticResource SteamPrimaryButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PrimaryButtonBorder" Property="Background"
                                    Value="{StaticResource SteamPrimaryButtonPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PrimaryButtonBorder" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="PrimaryButtonBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fluent ContentDialog primary buttons resolve this standard resource key. -->
    <Style x:Key="AccentButtonStyle" TargetType="Button"
           BasedOn="{StaticResource SteamPrimaryButtonStyle}"/>

    <Style x:Key="SteamDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SteamSecondaryButtonStyle}">
        <Setter Property="Foreground" Value="#FFB5B5"/>
        <Setter Property="BorderBrush" Value="#8C4444"/>
        <Setter Property="Background" Value="#482A31"/>
    </Style>

    <!-- Minimal scrollbars: transparent track, no arrow buttons, thumb only. -->
    <ControlTemplate x:Key="SteamVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Width="12" Background="Transparent">
            <Track x:Name="PART_Track"
                   Orientation="Vertical"
                   IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Focusable="False"
                                  Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinHeight="28" Margin="2,0">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ThumbBody"
                                        Background="#687281"
                                        CornerRadius="4"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbBody" Property="Background" Value="#8792A1"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ThumbBody" Property="Background" Value="#A4AFBC"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Focusable="False"
                                  Opacity="0"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SteamHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Height="12" Background="Transparent">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal"
                   IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  Focusable="False"
                                  Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="28" Margin="0,2">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ThumbBody"
                                        Background="#687281"
                                        CornerRadius="4"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ThumbBody" Property="Background" Value="#8792A1"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="ThumbBody" Property="Background" Value="#A4AFBC"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ThumbBody" Property="Opacity" Value="0.35"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  Focusable="False"
                                  Opacity="0"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template" Value="{StaticResource SteamVerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template" Value="{StaticResource SteamHorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
